+    display: grid;
+    grid-template-columns: none;
+    grid-auto-flow: column;
+    grid-auto-columns: minmax(220px, 78%);
+    gap: 15px;
+    width: 100%;
+    min-width: 0;
+    max-width: 100%;
+    padding: 3px 3px 15px;
+    overflow-x: auto;
+    overscroll-behavior-x: contain;
+    scroll-snap-type: x mandatory;
+    scroll-padding-inline: 3px;
+    scrollbar-width: thin;
+    scrollbar-color: #a0ac8a #dadfd1;
+  }
+  .products::-webkit-scrollbar { height: 4px; }
+  .products::-webkit-scrollbar-track { background: #dadfd1; border-radius: 4px; }
+  .products::-webkit-scrollbar-thumb { background: #a0ac8a; border-radius: 4px; }
