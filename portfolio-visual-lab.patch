+import { useId } from 'react';
+import s from '../../styles/visual-lab.module.css';
+
+// Lightweight, original vector/CSS covers. Gallery cards never create WebGL contexts.
+export default function LabArtwork({ kind }) {
+  const uid = useId().replace(/:/g, '');
+  return (
+    <div className={`${s.artwork} ${s[`art_${kind}`]}`} aria-hidden="true">
+      {kind === 'aura' && <>
+        <span className={s.artWord}>aura.</span>
+        <div className={s.headphones}><i className={s.headband} /><i className={s.innerBand} /><i className={s.earLeft} /><i className={s.earRight} /><i className={s.earShine} /></div>
+        <span className={s.artSub}>SOUND. REIMAGINED.</span>
+        <div className={s.artSwatches}><i /><i /><i /></div>
+      </>}
+      {kind === 'folio' && <>
+        <span className={s.folioLabel}>FORM / FEELING</span>
+        <div className={s.folioSun} /><div className={s.folioArch} /><div className={s.folioArchSecond} />
+        <span className={s.folioType}>A different<br /><em>perspective.</em></span>
+        <span className={s.folioMark}>F.</span>
+      </>}
+      {kind === 'pulse' && <div className={s.miniDashboard}>
+        <div className={s.miniNav}><b>pulse<span>®</span></b><i /><i /><i /></div>
+        <div className={s.miniDashboardBody}><span>Overview</span><strong>€24,890<span>+18.6%</span></strong>
+          <svg viewBox="0 0 400 150" fill="none"><defs><linearGradient id={`${uid}chart`} x1="0" y1="0" x2="0" y2="1"><stop stopColor="#bfff3c" stopOpacity=".35"/><stop offset="1" stopColor="#bfff3c" stopOpacity="0"/></linearGradient></defs><path d="M0 123 C24 123 25 92 48 96 S77 131 102 98 S132 82 151 80 S180 108 200 67 S227 78 250 49 S281 58 304 31 S339 52 358 21 S384 26 400 5 V150 H0Z" fill={`url(#${uid}chart)`}/><path d="M0 123 C24 123 25 92 48 96 S77 131 102 98 S132 82 151 80 S180 108 200 67 S227 78 250 49 S281 58 304 31 S339 52 358 21 S384 26 400 5" stroke="#bfff3c" strokeWidth="3"/></svg>
+          <div className={s.miniMetrics}><i>Sessions<b>8,462</b></i><i>Conversion<b>4.82%</b></i><i>Customers<b>1,204</b></i></div>
+        </div>
+      </div>}
+      {kind === 'flux' && <><span className={s.fluxWord}>flux</span><div className={s.fluxForm}>{Array.from({ length: 7 }, (_, i) => <i key={i} style={{ '--i': i }} />)}</div><span className={s.artSub}>FORM IS A FEELING.</span></>}
+      {kind === 'kinetic' && <><div className={s.kineticGrid}/><div className={s.kineticObject}><i /><i /><i /><i /></div><span className={s.kineticType}>Move<br /><em>something.</em></span><span className={s.kineticCursor}>✦</span></>}
+      {kind === 'atelier' && <><span className={s.atelierWord}>atelier</span><div className={s.lamp}><i className={s.lampShade}/><i className={s.lampStem}/><i className={s.lampBase}/></div><span className={s.atelierCaption}>LESS, BUT LOVELIER.</span><span className={s.atelierCircle}>a</span></>}
+      {kind === 'orbit' && <><span className={s.orbitWord}>O R B I T</span><svg viewBox="0 0 500 320" className={s.galaxy}><defs><radialGradient id={`${uid}galaxy`}><stop stopColor="#d7d0ff" stopOpacity=".8"/><stop offset=".12" stopColor="#9e8aff" stopOpacity=".3"/><stop offset="1" stopColor="#7b61ff" stopOpacity="0"/></radialGradient></defs><ellipse cx="250" cy="160" rx="230" ry="145" fill={`url(#${uid}galaxy)`}/>{Array.from({ length: 220 }, (_, i) => { const r = 8 + Math.sqrt(i / 220) * 205; const a = i * 2.399963 + r * .012; return <circle key={i} cx={250 + Math.cos(a) * r} cy={160 + Math.sin(a) * r * .48} r={i % 9 === 0 ? 1.8 : .9} fill={i % 3 === 0 ? '#bfff3c' : '#d4caff'} opacity={.3 + (i % 7) * .1}/>; })}</svg><i className={s.orbitRing}/><span className={s.artSub}>A UNIVERSE WITHIN REACH.</span></>}
+      {kind === 'palette' && <><span className={s.paletteTop}>TYPE AS EXPRESSION</span><div className={s.paletteText}>Aa<span>&</span>Bb.</div><div className={s.paletteSwatches}><i/><i/><i/><i/></div></>}
+      {kind === 'relay' && <div className={s.miniBoard}><div className={s.boardTitle}>relay<span>Workspace / Design</span></div><div className={s.boardCols}>{['Planned', 'In progress', 'Complete'].map((title, i) => <div key={title}><span>{title}</span>{[0, 1].map(n => <div className={`${s.boardCard} ${i === 1 && n === 0 ? s.boardFloat : ''}`} key={n}><i style={{ background: ['#a4a1ff','#bfff3c','#89d6bd'][(i+n)%3] }}/><b>{[['Design system', 'Landing page'],['Explore motion', 'Review layouts'],['Brand direction', 'Set the mood']][i][n]}</b><small>◉ <span>◌ ◌</span></small></div>)}</div>)}</div></div>}
+    </div>
+  );
+}
diff --git a/components/lab/LabDialog.jsx b/components/lab/LabDialog.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..0ce7de1f9d981e2b686413f6c76bb6375f1c30bd
--- /dev/null
+++ b/components/lab/LabDialog.jsx
@@ -0,0 +1,105 @@
+import { Component, useEffect, useRef, useState } from 'react';
+import dynamic from 'next/dynamic';
+import { useRouter } from 'next/router';
+import { FiChevronLeft, FiChevronRight, FiCopy, FiCheck, FiX } from 'react-icons/fi';
+import { LAB_EXPERIMENTS, getLabCopy } from '../../lib/lab';
+import s from '../../styles/visual-lab.module.css';
+
+function Loading({ error, retry }) {
+  const { locale } = useRouter();
+  const copy = getLabCopy(locale);
+  if (error) return <div className={s.demoError} role="alert"><p>{copy.error}</p><button className={s.secondaryButton} onClick={retry}>{copy.retry}</button></div>;
+  return <div className={s.demoLoading} role="status"><p className={s.srOnly}>{copy.loading}</p><span aria-hidden="true" /><span aria-hidden="true" /><span aria-hidden="true" /></div>;
+}
+const SpatialDemo = dynamic(() => import('./spatial/SpatialDemo'), { ssr: false, loading: Loading });
+const FrontendDemo = dynamic(() => import('./frontend/FrontendDemo'), { ssr: false, loading: Loading });
+const InterfaceDemo = dynamic(() => import('./interfaces/InterfaceDemo'), { ssr: false, loading: Loading });
+
+class ExperimentBoundary extends Component {
+  state = { failed: false };
+  static getDerivedStateFromError() { return { failed: true }; }
+  render() {
+    if (this.state.failed) return <div className={s.demoError} role="alert"><p>{this.props.copy.error}</p><button className={s.secondaryButton} onClick={() => this.setState({ failed: false })}>{this.props.copy.retry}</button></div>;
+    return this.props.children;
+  }
+}
+
+export default function LabDialog({ experiment, locale, copy, reducedMotion, onClose, onSelect }) {
+  const dialogRef = useRef(null);
+  const closeRef = useRef(null);
+  const [copied, setCopied] = useState(false);
+  const [copyFallback, setCopyFallback] = useState('');
+  const copyTimer = useRef();
+  const index = LAB_EXPERIMENTS.findIndex(item => item.id === experiment.id);
+  const details = copy.descriptions[experiment.id];
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    const priorFocus = document.activeElement;
+    const previousOverflow = document.body.style.overflow;
+    const lenis = window.__lenis;
+    const wasStopped = lenis?.isStopped;
+    document.body.style.overflow = 'hidden';
+    lenis?.stop();
+    dialog.showModal();
+    closeRef.current?.focus({ preventScroll: true });
+    return () => {
+      clearTimeout(copyTimer.current);
+      dialog.close();
+      document.body.style.overflow = previousOverflow;
+      if (!wasStopped) lenis?.start();
+      if (priorFocus?.isConnected) priorFocus.focus({ preventScroll: true });
+    };
+  }, []);
+
+  useEffect(() => {
+    setCopied(false);
+    setCopyFallback('');
+    if (dialogRef.current) dialogRef.current.scrollTop = 0;
+  }, [experiment.id]);
+
+  const copyLink = async () => {
+    const url = new URL(window.location.href);
+    url.search = '';
+    url.searchParams.set('demo', experiment.id);
+    url.hash = '';
+    try {
+      if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
+      await navigator.clipboard.writeText(url.href);
+      setCopied(true);
+      clearTimeout(copyTimer.current);
+      copyTimer.current = setTimeout(() => setCopied(false), 2200);
+    } catch {
+      setCopyFallback(url.href);
+    }
+  };
+
+  const Demo = experiment.category === 'spatial' ? SpatialDemo : experiment.category === 'creative' ? FrontendDemo : InterfaceDemo;
+  return (
+    <dialog ref={dialogRef} className={s.dialog} data-lenis-prevent data-paused={reducedMotion ? 'true' : 'false'} aria-labelledby="lab-dialog-title" aria-describedby="lab-dialog-description"
+      onCancel={event => { event.preventDefault(); onClose(); }}
+      onClick={event => { if (event.target === dialogRef.current) onClose(); }}>
+      <div className={s.dialogInner} data-lenis-prevent>
+        <header className={s.dialogBar}>
+          <div className={s.dialogIdentity}><span className={s.dialogMark} style={{ backgroundColor: experiment.accent }} /><div><h2 id="lab-dialog-title">{experiment.name}</h2><p>{copy.categories[experiment.category]}</p></div></div>
+          <div className={s.dialogActions}>
+            <button onClick={() => onSelect(LAB_EXPERIMENTS[(index + LAB_EXPERIMENTS.length - 1) % LAB_EXPERIMENTS.length].id)} aria-label={copy.previous} title={copy.previous}><FiChevronLeft /></button>
+            <button onClick={() => onSelect(LAB_EXPERIMENTS[(index + 1) % LAB_EXPERIMENTS.length].id)} aria-label={copy.next} title={copy.next}><FiChevronRight /></button>
+            <button onClick={copyLink} aria-label={copied ? (locale === 'en' ? 'Link copied' : 'Link kopiert') : (locale === 'en' ? 'Copy demo link' : 'Demo-Link kopieren')} title={locale === 'en' ? 'Copy demo link' : 'Demo-Link kopieren'}>{copied ? <FiCheck /> : <FiCopy />}</button>
+            <span className={s.closeHint}>{copy.closeHint}</span>
+            <button ref={closeRef} onClick={onClose} aria-label={copy.close} title={copy.close} className={s.closeButton}><FiX /></button>
+          </div>
+        </header>
+        {copyFallback && <label className={s.copyFallback}>{locale === 'en' ? 'Copy this link:' : 'Diesen Link kopieren:'}<input value={copyFallback} readOnly onFocus={event => event.target.select()} /></label>}
+        <div className={s.srOnly} role="status">{copied ? (locale === 'en' ? 'Link copied' : 'Link kopiert') : ''}</div>
+        <div className={s.demoStage}>
+          <ExperimentBoundary key={experiment.id} copy={copy}><Demo key={experiment.id} id={experiment.id} locale={locale} reducedMotion={reducedMotion} /></ExperimentBoundary>
+        </div>
+        <div className={s.dialogNote}>
+          <div><span>{copy.detail}</span><p id="lab-dialog-description">{details[2]}</p></div>
+          <div className={s.dialogTags}>{experiment.tags.map(tag => <span key={tag}>{tag}</span>)}</div>
+        </div>
+      </div>
+    </dialog>
+  );
+}
diff --git a/components/lab/VisualLab.jsx b/components/lab/VisualLab.jsx
new file mode 100644
index 0000000000000000000000000000000000000000..6689bcb781d0ca485ff789a9c54de6c40aff3361
--- /dev/null
+++ b/components/lab/VisualLab.jsx
@@ -0,0 +1,112 @@
+import { useEffect, useRef, useState } from 'react';
+import Link from 'next/link';
+import dynamic from 'next/dynamic';
+import { useRouter } from 'next/router';
+import { MotionConfig, motion, useInView, useReducedMotion } from 'framer-motion';
+import { FiBox, FiPause, FiPlay, FiPlus, FiMail } from 'react-icons/fi';
+import Seo from '../Seo';
+import { getLabCopy, LAB_EXPERIMENTS } from '../../lib/lab';
+import { SITE } from '../../lib/site';
+import LabArtwork from './LabArtwork';
+import LabDialog from './LabDialog';
+import s from '../../styles/visual-lab.module.css';
+
+const Scene = dynamic(() => import('./spatial/Scene'), { ssr: false, loading: () => <LabArtwork kind="flux" /> });
+
+export default function VisualLab() {
+  const router = useRouter();
+  const locale = router.locale === 'en' ? 'en' : 'de';
+  const copy = getLabCopy(locale);
+  const [filter, setFilter] = useState('all');
+  const [selected, setSelected] = useState(null);
+  const [paused, setPaused] = useState(false);
+  const systemReduced = useReducedMotion();
+  const reducedMotion = Boolean(systemReduced || paused);
+  const heroRef = useRef(null);
+  const heroVisible = useInView(heroRef, { margin: '100px' });
+  const active = LAB_EXPERIMENTS.find(item => item.id === selected);
+  const shown = LAB_EXPERIMENTS.filter(item => filter === 'all' || item.category === filter);
+
+  useEffect(() => {
+    if (!router.isReady) return;
+    const demo = typeof router.query.demo === 'string' ? router.query.demo : '';
+    setSelected(LAB_EXPERIMENTS.some(item => item.id === demo) ? demo : null);
+  }, [router.isReady, router.query.demo]);
+
+  function closeDemo() {
+    setSelected(null);
+    if (router.query.demo) router.replace({ pathname: '/lab', query: {} }, undefined, { shallow: true, scroll: false });
+  }
+
+  function selectDemo(id) {
+    setSelected(id);
+    if (router.query.demo) router.replace({ pathname: '/lab', query: { demo: id } }, undefined, { shallow: true, scroll: false });
+  }
+
+  return (
+    <MotionConfig reducedMotion={reducedMotion ? 'always' : 'user'}>
+      <Seo title="Visual Lab" description={copy.meta} path="/lab" />
+      <div className={s.page} data-paused={reducedMotion ? 'true' : 'false'}>
+        <section className={s.hero} ref={heroRef} aria-labelledby="lab-title">
+          <div className={s.heroGrid} aria-hidden="true" />
+          <div className={s.heroVisual}>
+            <div className={s.heroHalo} aria-hidden="true" />
+            <Scene mode="hero" active={heroVisible && !active} reducedMotion={reducedMotion} locale={locale} />
+            <div className={s.heroOrbit} aria-hidden="true" />
+            <span className={s.visualCaption} aria-hidden="true">FORM / LIGHT / INTERACTION</span>
+          </div>
+          <div className={s.container}>
+            <div className={s.heroTopline}><span className={s.labLogo}>Visual Lab<span>®</span></span><span className={s.heroEyebrow}>{copy.eyebrow}</span></div>
+            <div className={s.heroCopy}>
+              <h1 id="lab-title">{copy.title[0]}<br /><span>{copy.title[1]}</span></h1>
+              <p>{copy.intro}</p>
+              <div className={s.heroButtons}>
+                <a href="#experiments" className={s.primaryButton}>{copy.explore}<FiPlus aria-hidden="true" /></a>
+                <button onClick={() => setSelected('aura')} className={s.textButton}><FiBox aria-hidden="true" />{copy.enter}</button>
+              </div>
+            </div>
+            <div className={s.heroBottom}>
+              <p><span className={s.starMark} aria-hidden="true">✳</span>{copy.strap}</p>
+              <span>{copy.count}</span>
+              <button className={s.motionButton} onClick={() => setPaused(value => !value)} disabled={Boolean(systemReduced)} aria-pressed={reducedMotion}>
+                {reducedMotion ? <FiPlay aria-hidden="true" /> : <FiPause aria-hidden="true" />}{systemReduced ? copy.motionReduced : paused ? copy.motionOff : copy.motionOn}
+              </button>
+            </div>
+          </div>
+        </section>
+
+        <section id="experiments" className={`${s.collection} ${s.container}`} aria-labelledby="collection-title">
+          <div className={s.collectionHeading}><div><p className={s.eyebrow}>{copy.collection}</p><h2 id="collection-title">{copy.collectionTitle}</h2></div><p>{copy.collectionText}</p></div>
+          <div className={s.filterRow}>
+            <div className={s.filters} role="group" aria-label={locale === 'en' ? 'Filter experiments' : 'Experimente filtern'}>
+              {Object.entries(copy.categories).map(([key, label]) => <button key={key} className={filter === key ? s.filterActive : ''} onClick={() => setFilter(key)} aria-pressed={filter === key}>{label}<span>{key === 'all' ? LAB_EXPERIMENTS.length : LAB_EXPERIMENTS.filter(item => item.category === key).length}</span></button>)}
+            </div>
+            <span className={s.resultCount} role="status" aria-live="polite">{shown.length} / {LAB_EXPERIMENTS.length}</span>
+          </div>
+          <div className={s.gallery}>
+            {shown.map(item => <motion.article layout={!reducedMotion} key={item.id} initial={false} animate={{ opacity: 1 }} transition={{ duration: .35 }} className={`${s.card} ${item.featured && filter === 'all' ? s.featuredCard : ''}`} style={{ '--card-accent': item.accent }}>
+              <button className={s.cardButton} onClick={() => setSelected(item.id)} aria-label={`${copy.open}: ${item.name} — ${copy.descriptions[item.id][0]}`}>
+                <div className={s.cardVisual}>
+                  <LabArtwork kind={item.id} />
+                  <span className={s.categoryLabel}>{copy.categories[item.category]}</span>
+                  <span className={s.launchIcon} aria-hidden="true"><FiPlus /></span>
+                  <span className={s.cardOpen}>{copy.open}<FiPlus aria-hidden="true" /></span>
+                </div>
+                <div className={s.cardBody}><div className={s.cardTitle}><h3>{item.name}</h3><span>{item.tags[0]}</span></div><h4>{copy.descriptions[item.id][0]}</h4><p>{copy.descriptions[item.id][1]}</p></div>
+              </button>
+            </motion.article>)}
+          </div>
+          <p className={s.frontendNote}>{copy.frontendNote}</p>
+        </section>
+
+        <section className={`${s.labContact} ${s.container}`}>
+          <span className={s.contactStar} aria-hidden="true">✳</span>
+          <div><h2>{copy.footerTitle}</h2><p>{copy.footerText}</p></div>
+          <a href={`mailto:${SITE.email}`} className={s.primaryButton}><FiMail aria-hidden="true" />{copy.footerCta}</a>
+          <Link href="/" className={s.backHome}>{locale === 'en' ? 'Back to portfolio' : 'Zurück zum Portfolio'}</Link>
+        </section>
+      </div>
+      {active && <LabDialog experiment={active} locale={locale} copy={copy} reducedMotion={reducedMotion} onClose={closeDemo} onSelect={selectDemo} />}
+    </MotionConfig>
+  );
+}
diff --git a/components/lab/frontend/EditorialGallery.jsx b/components/lab/frontend/EditorialGallery.jsx
