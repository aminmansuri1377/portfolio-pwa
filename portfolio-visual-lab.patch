+const INITIAL_TASKS = [
+  { id: 'task-1', copy: 0, status: 'todo', priority: 'high', tag: 'EXPLORATION' },
+  { id: 'task-2', copy: 1, status: 'doing', priority: 'high', tag: 'MOTION' },
