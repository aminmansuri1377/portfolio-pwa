+.art_relay { background: radial-gradient(ellipse at 70% 70%,#244e45,#101e1b); padding: 72px 19px 20px; }.miniBoard { border-radius: 6px; background: #142421; border: 1px solid #b1e5ce24; box-shadow: 12px 20px 24px #0004; transform: rotate(-4deg); padding: 13px 12px; }.boardTitle { font: 500 1.2rem var(--font-display),sans-serif; color: #e1f6e9; margin-bottom: 17px; }.boardTitle > span { display: block; font: 400 .5625rem var(--font-mono),monospace; color: #709b89; margin-top: 3px; }.boardCols { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 7px; }.boardCols > div > span { display: block; color: #98b3a7; font-size: .5rem; margin-bottom: 7px; white-space: nowrap; }.boardCard { padding: 8px 7px; background: #203831; border: 1px solid #afd5c214; border-radius: 4px; margin-bottom: 7px; height: 60px; }.boardCard > i { display: block; width: 20px; height: 3px; border-radius: 4px; }.boardCard > b { display: block; font-size: .46875rem; color: #c0d8ca; margin-top: 6px; white-space: nowrap; }.boardCard > small { display: flex; justify-content: space-between; font-size: .5rem; color: #789f88; margin-top: 7px; }.boardFloat { transform: translate(9px,-7px) rotate(9deg); border-color: #8aceac99; box-shadow: 7px 10px 12px #0006; }
+
+/* Native dialog is in the top layer: focus is trapped and the page becomes inert. */
+.dialog { padding: 0; margin: auto; width: min(1240px,calc(100% - 40px)); max-width: none; max-height: calc(100dvh - 40px); border: 1px solid #6c7c6255; border-radius: 18px; color: #f0f3ec; background: #0b0e10; box-shadow: 0 30px 120px #000a; font-family: var(--font-body),Inter,system-ui,sans-serif; overflow-y: auto; overscroll-behavior: contain; }
+.dialog::backdrop { background: #020505cf; backdrop-filter: blur(12px); }
+.dialogInner { min-width: 0; }
+.dialogBar { position: sticky; top: 0; z-index: 12; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 18px 24px; border-bottom: 1px solid #ffffff14; background: #0b0e10f5; backdrop-filter: blur(16px); }
+.dialogIdentity { display: flex; align-items: center; gap: 12px; }.dialogMark { width: 26px; height: 26px; border-radius: 7px; transform: rotate(-10deg); }.dialogIdentity h2 { font: 500 1.125rem var(--font-display),sans-serif; letter-spacing: .08em; }.dialogIdentity p { color: #909d92; font-size: .8125rem; margin-top: 2px; }
+.dialogActions { display: flex; align-items: center; gap: 7px; }.dialogActions button { display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid #ffffff18; border-radius: 7px; color: #aab7a8; transition: background .2s,color .2s; }.dialogActions button:hover { color: #e1fad3; background: #ffffff0b; }.dialogActions button.closeButton { margin-left: 5px; background: #ffffff0b; color: #eaf4e3; }.dialogActions svg { width: 18px; height: 18px; }.closeHint { margin-left: 12px; font: 400 .75rem var(--font-mono),monospace; color: #798575; }
+.demoStage { padding: 20px; min-height: 450px; }
+.dialogNote { display: flex; justify-content: space-between; align-items: flex-start; gap: 30px; padding: 0 26px 24px; }.dialogNote > div > span { font: 400 .75rem var(--font-mono),monospace; letter-spacing: .08em; color: #a6b89c; }.dialogNote p { max-width: 700px; font-size: .875rem; line-height: 1.7; color: #8f9b91; margin-top: 7px; }.dialogTags { display: flex; flex-wrap: wrap; gap: 7px; justify-content: flex-end; padding-top: 3px; }.dialogTags > span { white-space: nowrap; padding: 5px 8px; background: #ffffff05; border: 1px solid #ffffff10; border-radius: 4px; font-size: .6875rem !important; letter-spacing: 0 !important; }
+.demoLoading { min-height: 480px; display: flex; align-items: center; justify-content: center; gap: 12px; background: radial-gradient(ellipse at center,#bfff3c0a,transparent 60%); }.demoLoading span { width: 14px; height: 14px; background: #bfff3c; border-radius: 3px; animation: labLoad 1s ease-in-out infinite alternate; }.demoLoading span:nth-child(2){animation-delay:.2s}.demoLoading span:nth-child(3){animation-delay:.4s}
