+.secondaryButton { border: 1px solid #bfff3c55; padding: 12px 20px; border-radius: 6px; color: #bfff3c; }
+.copyFallback { display: flex; gap: 14px; flex-wrap: wrap; padding: 14px 24px 0; font-size: .875rem; color: #b3c7a7; }.copyFallback input { flex: 1; min-width: 200px; padding: 8px; background: #111916; border: 1px solid #ffffff25; border-radius: 5px; color: #dce5d7; font-size: .875rem; }
+.srOnly { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
+@keyframes labLoad { to { opacity: .2; transform: translateY(-12px); } }
+.page[data-paused=true] * { animation-play-state: paused !important; }
