+}
+
+.reducedMotion *, .reducedMotion *::before, .reducedMotion *::after { animation: none !important; transition: none !important; }
+
+
+/* The collection stays readable on narrow screens; keyboard focus also scrolls
+   native overflow containers into view without a pointer-only carousel. */
+.collection { min-width: 0; }
+.swipeHint { display: none; }
+@media (max-width: 520px) {
