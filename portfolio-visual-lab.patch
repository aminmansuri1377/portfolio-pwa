+  .productDetails h5 { font-size: 14px; }
+  .productDetails > span { font-size: 14px; }
+  .swatches { gap: 0; }
+  .swatches button { width: 25px; height: 25px; }
+  .addButton { font-size: 14px !important; gap: 3px; }
+  .addButton svg { width: 11px; }
+  .bag { padding: 18px; }
+  .smallArt { height: 54px; }
+  .smallArt > div { transform: scale(.28); }
+  .smallArt::after { bottom: 3px; }
