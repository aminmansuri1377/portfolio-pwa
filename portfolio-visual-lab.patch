+  .productDetails h5 { font-size: 16px; }
+  .productDetails > span { font-size: 14px; }
+  .swatches { gap: 5px; margin-bottom: 12px; }
+  .swatches button { width: 32px; height: 32px; padding: 5px; }
+  .swatches button::after { width: 20px; height: 20px; }
+  .swatches > span { display: inline-block; font-size: 14px; }
+  .addButton { font-size: 14px !important; padding: 12px; min-height: 44px; gap: 8px; }
+  .addButton svg { width: 16px; height: 16px; }
+  .smallArt { width: 45px; height: 54px; }
+  .smallArt > div { transform: scale(.28); }
+  .smallArt::after { bottom: 3px; }
+}
+
+@media (max-width: 520px) {
+  .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .metric:first-child { grid-column: 1 / -1; }
+  .metric > div { font-size: 14px; min-height: auto; }
+  .metric > strong { font-size: 26px; }
+  .metric:first-child > strong { font-size: 34px; }
+  .metric > div > span:first-child { overflow-wrap: anywhere; }
+  .chart figcaption { align-items: flex-start; flex-direction: column; gap: 7px; }
+  .boardTitle { flex-wrap: wrap; }
+}
