+              <p className="mt-2 font-display text-2xl font-bold">{node}</p>
+            </div>
+          ))}
+        </div>
+
+        <div className="rounded-2xl border border-white/10 bg-ink-900/80 p-4">
+          <div className="mb-3 flex flex-wrap items-center justify-between gap-3">
+            <p className="font-display text-sm font-semibold">
+              {t('chartLoad')} {live && moving && <span className="ml-2 inline-block h-2 w-2 animate-pulse rounded-full bg-lime align-middle" />}
+            </p>
+            <div className="flex flex-wrap items-center gap-3">
+              <ChipGroup
+                label={t('timeRange')}
+                value={range}
+                onChange={setRange}
+                options={[
+                  { value: '30', label: '30s' },
+                  { value: '60', label: '60s' },
+                  { value: '120', label: '120s' },
+                ]}
+              />
+              <ActionButton disabled={reducedMotion} onClick={() => setLive((v) => !v)}>{live && moving ? t('pause') : t('resume')}</ActionButton>
+            </div>
+          </div>
+          <svg
+            ref={svg}
+            viewBox={`0 0 ${W} ${H}`}
+            className="w-full touch-none"
+            onPointerMove={onMove}
+            onPointerLeave={() => setHoverIdx(null)}
+            role="img"
+            aria-label={t('chartLoad')}
+          >
+            <defs>
+              <linearGradient id={areaId} x1="0" x2="0" y1="0" y2="1">
+                <stop offset="0%" stopColor="#bfff3c" stopOpacity="0.4" />
+                <stop offset="100%" stopColor="#bfff3c" stopOpacity="0" />
+              </linearGradient>
+            </defs>
+            {[0, 25, 50, 75, 100].map((g) => {
+              const y = PAD.t + (1 - g / 100) * (H - PAD.t - PAD.b);
+              return (
+                <g key={g}>
+                  <line x1={PAD.l} x2={W - PAD.r} y1={y} y2={y} stroke="rgba(255,255,255,0.07)" />
+                  <text x={PAD.l - 8} y={y + 3} textAnchor="end" fontSize="9" fill="#9c9ca8">{g}</text>
+                </g>
+              );
+            })}
+            <path d={area} fill={`url(#${areaId})`} />
+            <path d={line} fill="none" stroke="#bfff3c" strokeWidth="2" strokeLinecap="round" />
+            {hp && (
+              <g>
+                <line x1={hp[0]} x2={hp[0]} y1={PAD.t} y2={H - PAD.b} stroke="rgba(255,255,255,0.3)" strokeDasharray="3 3" />
+                <circle cx={hp[0]} cy={hp[1]} r="5" fill="#060609" stroke="#bfff3c" strokeWidth="2" />
+                <g transform={`translate(${Math.min(hp[0] + 8, W - 90)}, ${Math.max(hp[1] - 30, 4)})`}>
+                  <rect width="82" height="22" rx="6" fill="#14141c" stroke="rgba(255,255,255,0.15)" />
+                  <text x="41" y="15" textAnchor="middle" fontSize="11" fill="#fff" fontWeight="600">
+                    {view[hoverIdx].toFixed(1)}%
+                  </text>
+                </g>
+              </g>
+            )}
+          </svg>
+          <label className="mt-2 flex flex-wrap items-center gap-3 text-sm text-muted">{t('inspectChart')}<input type="range" min={0} max={view.length - 1} value={Math.min(hoverIdx ?? view.length - 1, view.length - 1)} onChange={event => setHoverIdx(Number(event.target.value))} className="h-8 min-w-[140px] flex-1 accent-lime" /><output className="font-mono text-white">{view[Math.min(hoverIdx ?? view.length - 1, view.length - 1)].toFixed(1)}%</output></label>
+        </div>
+
+        <div className="grid gap-4 md:grid-cols-2">
+          <div className="rounded-2xl border border-white/10 bg-ink-900/80 p-4">
+            <p className="mb-3 font-display text-sm font-semibold">{t('chartSources')}</p>
+            <Donut t={t} />
+          </div>
+          <div className="rounded-2xl border border-white/10 bg-ink-900/80 p-4">
+            <p className="mb-3 font-display text-sm font-semibold">{t('chartHours')}</p>
+            <div className="flex h-32 items-end gap-1.5">
+              {bars.map((b, i) => (
+                <motion.div
+                  key={i}
+                  initial={{ height: 0 }}
+                  animate={{ height: `${b}%` }}
+                  transition={{ delay: i * 0.04, type: 'spring', stiffness: 110, damping: 14 }}
+                  whileHover={{ scaleY: 1.06, backgroundColor: '#bfff3c' }}
+                  className="flex-1 origin-bottom rounded-t bg-violet/70"
+                />
+              ))}
+            </div>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/components/showcase/demos/FlowDemo.jsx b/components/showcase/demos/FlowDemo.jsx
new file mode 100644
index 0000000..cccf101
--- /dev/null
+++ b/components/showcase/demos/FlowDemo.jsx
@@ -0,0 +1,228 @@
+import { useEffect, useRef, useState } from 'react';
+import { useTranslations } from 'next-intl';
+import { ActionButton, ChipGroup, Panel } from '../controls';
+import { useShowcaseMotion } from '../Runtime';
+
+const PALETTES = {
+  neon: [84, 255],
+  ember: [8, 48],
+  ocean: [175, 230],
+};
+
+function makeNoise() {
+  const perm = new Uint8Array(512);
+  const base = Array.from({ length: 256 }, (_, i) => i);
+  for (let i = 255; i > 0; i--) {
+    const j = Math.floor(Math.random() * (i + 1));
+    [base[i], base[j]] = [base[j], base[i]];
+  }
+  for (let i = 0; i < 512; i++) perm[i] = base[i & 255];
+  const g = (h) => (h & 1 ? 1 : -1);
+  const fade = (t) => t * t * t * (t * (t * 6 - 15) + 10);
+  // 2D gradient-ish noise, returns roughly -1..1
+  return (x, y) => {
+    const xi = Math.floor(x) & 255;
+    const yi = Math.floor(y) & 255;
+    const xf = x - Math.floor(x);
+    const yf = y - Math.floor(y);
+    const u = fade(xf);
+    const v = fade(yf);
+    const val = (a, b, dx, dy) => g(perm[perm[a] + b]) * dx + g(perm[perm[a] + b] >> 1) * dy;
+    const n00 = val(xi, yi, xf, yf);
+    const n10 = val(xi + 1, yi, xf - 1, yf);
+    const n01 = val(xi, yi + 1, xf, yf - 1);
+    const n11 = val(xi + 1, yi + 1, xf - 1, yf - 1);
+    const a = n00 + u * (n10 - n00);
+    const b = n01 + u * (n11 - n01);
+    return a + v * (b - a);
+  };
+}
+
+export default function FlowDemo() {
+  const t = useTranslations('Showcase.ui');
+  const { animate } = useShowcaseMotion();
+  const activeRef = useRef(animate);
+  activeRef.current = animate;
+  const syncRef = useRef(() => {});
+  const repaintRef = useRef(() => {});
+  const [unavailable, setUnavailable] = useState(false);
+  const canvasRef = useRef(null);
+  const [palette, setPalette] = useState('neon');
+  const paletteRef = useRef('neon');
+  const clearRef = useRef(() => {});
+
+  useEffect(() => {
+    paletteRef.current = palette;
+    if (!activeRef.current) repaintRef.current();
+  }, [palette]);
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    const ctx = canvas.getContext('2d');
+    if (!ctx) { setUnavailable(true); return; }
+    const noise = makeNoise();
+    let repaint = () => {};
+    const COUNT = 1800;
+    let w = 0;
+    let h = 0;
+    let dpr = 1;
+    let raf = 0;
+    let time = 0;
+    const pointer = { x: -9999, y: -9999, down: false };
+    const parts = [];
+
+    const resize = () => {
+      dpr = Math.min(window.devicePixelRatio || 1, 2);
+      w = canvas.clientWidth;
+      h = canvas.clientHeight;
+      canvas.width = Math.max(1, Math.floor(w * dpr));
+      canvas.height = Math.max(1, Math.floor(h * dpr));
+      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      ctx.fillStyle = '#050508';
+      ctx.fillRect(0, 0, w, h);
+      if (!activeRef.current) repaint();
+    };
+
+    const spawn = (p) => {
+      p.x = Math.random() * w;
+      p.y = Math.random() * h;
+      p.life = 80 + Math.random() * 220;
+      p.hue = Math.random();
+      return p;
+    };
+
+    resize();
+    for (let i = 0; i < COUNT; i++) parts.push(spawn({}));
+    clearRef.current = () => {
+      ctx.fillStyle = '#050508';
+      ctx.fillRect(0, 0, w, h);
+    };
+
+    const ro = new ResizeObserver(resize);
+    ro.observe(canvas);
+
+    const step = () => {
+      time += 0.004;
+      ctx.fillStyle = 'rgba(5,5,8,0.07)';
+      ctx.fillRect(0, 0, w, h);
+      const [h1, h2] = PALETTES[paletteRef.current];
+      const scale = 0.0021;
+      ctx.lineWidth = 1.1;
+
+      for (let i = 0; i < parts.length; i++) {
+        const p = parts[i];
+        const angle = noise(p.x * scale + time, p.y * scale - time) * Math.PI * 3.2;
+        let vx = Math.cos(angle) * 1.5;
+        let vy = Math.sin(angle) * 1.5;
+
+        // the pointer swirls the field; holding the button pulls particles in
+        const dx = p.x - pointer.x;
+        const dy = p.y - pointer.y;
+        const d2 = dx * dx + dy * dy;
+        if (d2 < 22500) {
+          const f = (1 - d2 / 22500) * 3.2;
+          const d = Math.sqrt(d2) || 1;
+          if (pointer.down) {
+            vx -= (dx / d) * f * 1.4;
+            vy -= (dy / d) * f * 1.4;
+          } else {
+            vx += (-dy / d) * f;
+            vy += (dx / d) * f;
+          }
+        }
+
+        const nx = p.x + vx;
+        const ny = p.y + vy;
+        const hue = h1 + (h2 - h1) * ((p.hue + angle * 0.08 + 1) % 1);
+        ctx.strokeStyle = `hsla(${hue}, 95%, 62%, 0.55)`;
+        ctx.beginPath();
+        ctx.moveTo(p.x, p.y);
+        ctx.lineTo(nx, ny);
+        ctx.stroke();
+        p.x = nx;
+        p.y = ny;
+        p.life -= 1;
+        if (p.life <= 0 || p.x < -5 || p.x > w + 5 || p.y < -5 || p.y > h + 5) spawn(p);
+      }
+    };
+    let painted = false;
+    let previous = 0;
+    let carry = 0;
+    repaint = () => { for (let k = 0; k < 80; k++) step(); painted = true; };
+    repaintRef.current = repaint;
+    const tick = now => {
+      if (!activeRef.current) return;
+      carry += previous ? Math.min((now - previous) / 1000, .05) : 1 / 60;
+      previous = now;
+      while (carry >= 1 / 60) { step(); carry -= 1 / 60; painted = true; }
+      raf = requestAnimationFrame(tick);
+    };
+    syncRef.current = () => {
+      cancelAnimationFrame(raf);
+      previous = 0;
+      carry = 0;
+      if (activeRef.current) raf = requestAnimationFrame(tick);
+      else if (!painted) repaint();
+    };
+    syncRef.current();
+
+    const rect = () => canvas.getBoundingClientRect();
+    const move = (e) => {
+      const r = rect();
+      pointer.x = e.clientX - r.left;
+      pointer.y = e.clientY - r.top;
+    };
+    const down = (e) => {
+      if (!e.isPrimary) return;
+      canvas.setPointerCapture?.(e.pointerId);
+      move(e);
+      pointer.down = true;
+    };
+    const up = e => {
+      if (e?.pointerId != null && canvas.hasPointerCapture?.(e.pointerId)) canvas.releasePointerCapture(e.pointerId);
+      pointer.down = false;
+    };
+    const leave = () => {
+      pointer.x = -9999;
+      pointer.y = -9999;
+      pointer.down = false;
+    };
+    canvas.addEventListener('pointermove', move);
+    canvas.addEventListener('pointerdown', down);
+    window.addEventListener('pointerup', up);
+    canvas.addEventListener('pointercancel', up);
+    canvas.addEventListener('pointerleave', leave);
+
+    return () => {
+      cancelAnimationFrame(raf);
+      ro.disconnect();
+      canvas.removeEventListener('pointermove', move);
+      canvas.removeEventListener('pointerdown', down);
+      window.removeEventListener('pointerup', up);
+      canvas.removeEventListener('pointercancel', up);
+      syncRef.current = () => {};
+      repaintRef.current = () => {};
+      canvas.removeEventListener('pointerleave', leave);
+    };
+  }, []);
+
+  useEffect(() => syncRef.current(), [animate]);
+
+  return (
+    <div className="absolute inset-0">
+      {unavailable && <p className="absolute inset-0 grid place-items-center p-6 text-center text-muted">{t('canvasUnavailable')}</p>}
+      <canvas ref={canvasRef} className="h-full w-full touch-none" aria-label={t('flowAria')} />
+      <div className="pointer-events-none absolute inset-x-0 bottom-3 flex justify-center px-3">
+        <Panel className="pointer-events-auto flex flex-wrap items-end gap-x-6 gap-y-3">
+          <ChipGroup
+            label={t('palette')}
+            value={palette}
+            onChange={setPalette}
+            options={Object.keys(PALETTES).map((v) => ({ value: v, label: t(`palettes.${v}`) }))}
+          />
+          <ActionButton onClick={() => clearRef.current()}>{t('clear')}</ActionButton>
+        </Panel>
+      </div>
+    </div>
+  );
+}
diff --git a/components/showcase/demos/GalaxyDemo.jsx b/components/showcase/demos/GalaxyDemo.jsx
new file mode 100644
index 0000000..c593122
--- /dev/null
+++ b/components/showcase/demos/GalaxyDemo.jsx
@@ -0,0 +1,160 @@
+import { useEffect, useMemo, useRef, useState } from 'react';
+import { useThree } from '@react-three/fiber';
+import { ManagedCanvas as Canvas, useSceneFrame, FitScene } from '../Graphics';
+import { useTranslations } from 'next-intl';
+import { ActionButton } from '../controls';
+import { AdditiveBlending, Color, MathUtils } from 'three';
+
+const COUNT = 60000;
+
+const vertexShader = /* glsl */ `
+  uniform float uTime;
+  uniform float uSize;
+  uniform float uBurst;
+  uniform float uPixelRatio;
+  attribute float aScale;
+  attribute float aRand;
+  attribute vec3 aColor;
+  varying vec3 vColor;
+  varying float vAlpha;
+
+  void main() {
+    vec3 p = position;
+    float r = length(p.xz);
+    float a = atan(p.z, p.x);
+    // differential rotation: the core spins faster than the rim
+    a += uTime * 0.22 / (0.6 + r * 0.5);
+
+    // click shockwave: every star is pushed outwards by its own random amount
+    float shock = uBurst * (0.6 + aRand) * (1.0 - uBurst * 0.4);
+    r *= 1.0 + shock * 0.9;
+
+    p.x = cos(a) * r;
+    p.z = sin(a) * r;
+    p.y += sin(uTime * 0.8 + aRand * 40.0) * 0.04 + shock * (aRand - 0.5) * 2.0;
+
+    vec4 mv = modelViewMatrix * vec4(p, 1.0);
+    gl_Position = projectionMatrix * mv;
+    gl_PointSize = uSize * aScale * uPixelRatio * (1.0 / -mv.z);
+
+    vColor = aColor;
+    vAlpha = 0.55 + 0.45 * aRand;
+  }
+`;
+
+const fragmentShader = /* glsl */ `
+  varying vec3 vColor;
+  varying float vAlpha;
+
+  void main() {
+    float d = length(gl_PointCoord - 0.5);
+    if (d > 0.5) discard;
+    float s = pow(1.0 - d * 2.0, 2.2);
+    gl_FragColor = vec4(vColor * (0.6 + s), s * vAlpha);
+    #include <colorspace_fragment>
+  }
+`;
+
+function Stars({ burst }) {
+  const group = useRef();
+  const material = useRef();
+
+  const { positions, colors, scales, rands } = useMemo(() => {
+    const positions = new Float32Array(COUNT * 3);
+    const colors = new Float32Array(COUNT * 3);
+    const scales = new Float32Array(COUNT);
+    const rands = new Float32Array(COUNT);
+    const inner = new Color('#bfff3c');
+    const outer = new Color('#8b7cff');
+    const mixed = new Color();
+    const BRANCHES = 4;
+    const RADIUS = 5;
+    const SPIN = 1.1;
+    const scatter = () => Math.pow(Math.random(), 3.2) * (Math.random() < 0.5 ? 1 : -1);
+
+    for (let i = 0; i < COUNT; i++) {
+      const r = Math.pow(Math.random(), 0.8) * RADIUS;
+      const branch = ((i % BRANCHES) / BRANCHES) * Math.PI * 2;
+      const angle = branch + r * SPIN;
+      const k = 0.32 * r * 0.55 + 0.04;
+      positions[i * 3] = Math.cos(angle) * r + scatter() * k;
+      positions[i * 3 + 1] = scatter() * k * 0.6;
+      positions[i * 3 + 2] = Math.sin(angle) * r + scatter() * k;
+
+      mixed.copy(inner).lerp(outer, Math.min(1, r / RADIUS));
+      colors[i * 3] = mixed.r;
+      colors[i * 3 + 1] = mixed.g;
+      colors[i * 3 + 2] = mixed.b;
+
+      scales[i] = 0.35 + Math.random() * 1.1;
+      rands[i] = Math.random();
+    }
+    return { positions, colors, scales, rands };
+  }, []);
+
+  const uniforms = useMemo(
+    () => ({
+      uTime: { value: 0 },
+      uSize: { value: 36 },
+      uBurst: { value: 0 },
+      uPixelRatio: { value: 1 },
+    }),
+    []
+  );
+
+  const invalidate = useThree(state => state.invalidate);
+  useEffect(() => {
+    if (burst > 0) { uniforms.uBurst.value = 1; invalidate(); }
+  }, [burst, uniforms, invalidate]);
+
+  useSceneFrame((state, delta, elapsed, animate) => {
+    uniforms.uTime.value = elapsed;
+    uniforms.uPixelRatio.value = state.gl.getPixelRatio();
+    uniforms.uBurst.value = Math.max(0, uniforms.uBurst.value - delta * 0.85);
+    if (group.current) {
+      group.current.rotation.x = MathUtils.lerp(group.current.rotation.x, 0.25 - state.pointer.y * 0.55, animate ? .05 : 1);
+      group.current.rotation.z = MathUtils.lerp(group.current.rotation.z, state.pointer.x * 0.35, animate ? .05 : 1);
+    }
+  });
+
+  return (
+    <group ref={group}>
+      <points frustumCulled={false}>
+        <bufferGeometry>
+          <bufferAttribute attach="attributes-position" args={[positions, 3]} />
+          <bufferAttribute attach="attributes-aColor" args={[colors, 3]} />
+          <bufferAttribute attach="attributes-aScale" args={[scales, 1]} />
+          <bufferAttribute attach="attributes-aRand" args={[rands, 1]} />
+        </bufferGeometry>
+        <shaderMaterial
+          ref={material}
+          uniforms={uniforms}
+          vertexShader={vertexShader}
+          fragmentShader={fragmentShader}
+          transparent
+          depthWrite={false}
+          blending={AdditiveBlending}
+        />
+      </points>
+    </group>
+  );
+}
+
+export default function GalaxyDemo() {
+  const t = useTranslations('Showcase.ui');
+  const [burst, setBurst] = useState(0);
+  return (
+    <div className="absolute inset-0" onPointerDown={event => { if (event.target.tagName === 'CANVAS') setBurst(value => value + 1); }}>
+    <Canvas
+      dpr={[1, 1.6]}
+      camera={{ position: [0, 3.6, 7], fov: 55 }}
+      gl={{ antialias: false, powerPreference: 'high-performance' }}
+    >
+      <color attach="background" args={['#050508']} />
+      <FitScene radius={6.5} position={[0, 3.6, 7]} />
+      <Stars burst={burst} />
+    </Canvas>
+      <div className="absolute bottom-4 left-4"><ActionButton onClick={() => setBurst(value => value + 1)}>{t('burst')}</ActionButton></div>
+    </div>
+  );
+}
diff --git a/components/showcase/demos/MicroDemo.jsx b/components/showcase/demos/MicroDemo.jsx
