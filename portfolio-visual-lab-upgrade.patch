+import { memo, useEffect, useRef, useState } from 'react';
+import { ManagedCanvas as Canvas, useSceneFrame, FitScene } from '../Graphics';
+import { useShowcaseMotion } from '../Runtime';
+import { ContactShadows, Environment, Float, Lightformer, OrbitControls } from '@react-three/drei';
+import { useTranslations } from 'next-intl';
+import { ActionButton, ChipGroup, Panel, Swatches } from '../controls';
+
+const COLORS = ['#bfff3c', '#8b7cff', '#ff5d8f', '#4cc9f0', '#f4f4f0', '#1a1a24'];
+
+const FINISHES = {
+  matte: { metalness: 0, roughness: 0.85, clearcoat: 0, transmission: 0 },
+  gloss: { metalness: 0.1, roughness: 0.12, clearcoat: 1, transmission: 0 },
+  metal: { metalness: 1, roughness: 0.2, clearcoat: 0, transmission: 0 },
+  glass: { metalness: 0, roughness: 0.05, clearcoat: 0, transmission: 1 },
+};
+
+function Product({ shape, finish, color }) {
+  const mesh = useRef();
+  const { animate } = useShowcaseMotion();
+
+  // small "pop" whenever the geometry changes
+  useEffect(() => {
+    if (mesh.current) mesh.current.scale.setScalar(animate ? .6 : 1);
+  }, [shape, animate]);
+
+  useSceneFrame((state, delta, elapsed, animate) => {
+    if (!mesh.current) return;
+    const s = mesh.current.scale.x;
+    mesh.current.scale.setScalar(animate ? s + (1 - s) * 0.12 : 1);
+  });
+
+  const f = FINISHES[finish];
+
+  return (
+    <Float enabled={animate} speed={1.6} rotationIntensity={0.35} floatIntensity={0.7}>
+      <mesh ref={mesh} castShadow>
+        {shape === 'knot' && <torusKnotGeometry args={[0.8, 0.28, 240, 36]} />}
+        {shape === 'torus' && <torusGeometry args={[1, 0.4, 48, 96]} />}
+        {shape === 'gem' && <icosahedronGeometry args={[1.25, 0]} />}
+        {shape === 'capsule' && <capsuleGeometry args={[0.7, 1.2, 16, 48]} />}
+        <meshPhysicalMaterial
+          key={`${shape}-${finish}`}
+          color={color}
+          metalness={f.metalness}
+          roughness={f.roughness}
+          clearcoat={f.clearcoat}
+          clearcoatRoughness={0.05}
+          transmission={f.transmission}
+          thickness={1.2}
+          ior={1.45}
+          flatShading={shape === 'gem'}
+        />
+      </mesh>
+    </Float>
+  );
+}
+
+const StudioLights = memo(function StudioLights() {
+  return (<Environment resolution={256}>
+          <Lightformer form="rect" intensity={4} position={[0, 5, -4]} scale={[12, 6, 1]} />
+          <Lightformer form="ring" intensity={3.5} color="#bfff3c" position={[-6, 1, 2]} scale={4} />
+          <Lightformer form="rect" intensity={3} color="#8b7cff" position={[6, 2, 3]} scale={[4, 8, 1]} />
+          <Lightformer form="circle" intensity={2} color="#ffffff" position={[0, -3, 4]} scale={5} />
+        </Environment>);
+});
+
+export default function ConfiguratorDemo() {
+  const t = useTranslations('Showcase.ui');
+  const { animate, reducedMotion } = useShowcaseMotion();
+  const [shape, setShape] = useState('knot');
+  const [finish, setFinish] = useState('gloss');
+  const [color, setColor] = useState(COLORS[0]);
+  const [auto, setAuto] = useState(true);
+
+  return (
+    <div className="absolute inset-0 flex flex-col">
+      <div className="relative min-h-[300px] flex-1">
+      <Canvas dpr={[1, 1.6]} camera={{ position: [0, 0.4, 5.2], fov: 38 }} shadows>
+        <FitScene radius={1.9} position={[0, .4, 5.2]} />
+        <color attach="background" args={['#07070b']} />
+        <ambientLight intensity={0.35} />
+        <directionalLight position={[3, 5, 4]} intensity={1.2} />
+        <Product shape={shape} finish={finish} color={color} />
+        <ContactShadows position={[0, -1.7, 0]} opacity={0.55} blur={2.6} scale={10} far={4} />
+        <StudioLights />
+        <OrbitControls enablePan={false} minDistance={3.4} maxDistance={18} autoRotate={auto && animate} autoRotateSpeed={1.4} />
+      </Canvas>
+      </div>
+      <div className="shrink-0 p-3">
+        <Panel className="pointer-events-auto flex max-h-[44vh] w-full flex-wrap items-end gap-x-6 gap-y-3 overflow-y-auto" data-lenis-prevent>
+          <ChipGroup
+            label={t('shape')}
+            value={shape}
+            onChange={setShape}
+            options={['knot', 'torus', 'gem', 'capsule'].map((v) => ({ value: v, label: t(`shapes.${v}`) }))}
+          />
+          <ChipGroup
+            label={t('finish')}
+            value={finish}
+            onChange={setFinish}
+            options={['matte', 'gloss', 'metal', 'glass'].map((v) => ({ value: v, label: t(`finishes.${v}`) }))}
+          />
+          <Swatches label={t('color')} colors={COLORS} value={color} onChange={setColor} />
+          <ActionButton onClick={() => setAuto((a) => !a)} aria-pressed={auto && animate} disabled={reducedMotion}>
+            {auto && animate ? t('autoRotateOn') : t('autoRotateOff')}
+          </ActionButton>
+        </Panel>
+      </div>
+    </div>
+  );
+}
diff --git a/components/showcase/demos/CubesDemo.jsx b/components/showcase/demos/CubesDemo.jsx
new file mode 100644
index 0000000..5020124
--- /dev/null
+++ b/components/showcase/demos/CubesDemo.jsx
@@ -0,0 +1,77 @@
+import { useMemo, useRef } from 'react';
+import { ManagedCanvas as Canvas, useSceneFrame } from '../Graphics';
+import { Color, Object3D, Plane, Vector3 } from 'three';
+
+const N = 48;
+const GAP = 0.34;
+const SIZE = GAP * 0.78;
+
+function Grid() {
+  const mesh = useRef();
+  const light = useRef();
+  const dummy = useMemo(() => new Object3D(), []);
+  const color = useMemo(() => new Color(), []);
+  const palette = useMemo(
+    () => ({ low: new Color('#1a1a2a'), mid: new Color('#8b7cff'), high: new Color('#bfff3c') }),
+    []
+  );
+  const plane = useMemo(() => new Plane(new Vector3(0, 1, 0), 0), []);
+  const hit = useMemo(() => new Vector3(), []);
+  const cursor = useRef(new Vector3(0, 0, 0));
+
+  useSceneFrame((state, delta, elapsed, animate) => {
+    const t = elapsed;
+    state.raycaster.setFromCamera(state.pointer, state.camera);
+    if (state.raycaster.ray.intersectPlane(plane, hit)) cursor.current.lerp(hit, animate ? .14 : 1);
+    const cx = cursor.current.x;
+    const cz = cursor.current.z;
+
+    let i = 0;
+    for (let ix = 0; ix < N; ix++) {
+      for (let iz = 0; iz < N; iz++) {
+        const x = (ix - N / 2 + 0.5) * GAP;
+        const z = (iz - N / 2 + 0.5) * GAP;
+        const wave = 0.32 * Math.sin(x * 0.9 + t * 1.2) * Math.cos(z * 0.9 - t * 0.9);
+        const dist = Math.hypot(x - cx, z - cz);
+        const bump = Math.exp(-dist * dist * 0.7) * 1.9 * (0.65 + 0.35 * Math.sin(t * 4 - dist * 3));
+        const h = Math.max(0.12, 0.55 + wave + bump);
+
+        dummy.position.set(x, h / 2, z);
+        dummy.scale.set(1, h, 1);
+        dummy.updateMatrix();
+        mesh.current.setMatrixAt(i, dummy.matrix);
+
+        const n = Math.min(1, Math.max(0, (h - 0.2) / 2.1));
+        if (n < 0.5) color.copy(palette.low).lerp(palette.mid, n * 2);
+        else color.copy(palette.mid).lerp(palette.high, (n - 0.5) * 2);
+        mesh.current.setColorAt(i, color);
+        i++;
+      }
+    }
+    mesh.current.instanceMatrix.needsUpdate = true;
+    if (mesh.current.instanceColor) mesh.current.instanceColor.needsUpdate = true;
+    if (light.current) light.current.position.set(cx, 2.2, cz);
+  });
+
+  return (
+    <>
+      <instancedMesh ref={mesh} args={[null, null, N * N]} frustumCulled={false}>
+        <boxGeometry args={[SIZE, 1, SIZE]} />
+        <meshStandardMaterial roughness={0.35} metalness={0.35} />
+      </instancedMesh>
+      <pointLight ref={light} color="#bfff3c" intensity={30} distance={9} />
+    </>
+  );
+}
+
+export default function CubesDemo() {
+  return (
+    <Canvas dpr={[1, 1.6]} camera={{ position: [0, 7.5, 9.5], fov: 45 }}>
+      <color attach="background" args={['#050508']} />
+      <fog attach="fog" args={['#050508', 10, 22]} />
+      <ambientLight intensity={0.55} />
+      <directionalLight position={[5, 9, 4]} intensity={1.6} />
+      <Grid />
+    </Canvas>
+  );
+}
diff --git a/components/showcase/demos/DashboardDemo.jsx b/components/showcase/demos/DashboardDemo.jsx
new file mode 100644
index 0000000..e671f31
--- /dev/null
+++ b/components/showcase/demos/DashboardDemo.jsx
@@ -0,0 +1,264 @@
+import { useEffect, useId, useMemo, useRef, useState } from 'react';
+import { animate, motion, useMotionValue, useTransform } from 'framer-motion';
+import { useTranslations } from 'next-intl';
+import { ActionButton, ChipGroup } from '../controls';
+import { useShowcaseMotion } from '../Runtime';
+
+const W = 640;
+const H = 220;
+const PAD = { l: 38, r: 12, t: 14, b: 26 };
+
+function smooth(pts) {
+  if (pts.length < 2) return '';
+  let d = `M${pts[0][0]},${pts[0][1]}`;
+  for (let i = 1; i < pts.length - 1; i++) {
+    const [x0, y0] = pts[i];
+    const [x1, y1] = pts[i + 1];
+    d += ` Q${x0},${y0} ${(x0 + x1) / 2},${(y0 + y1) / 2}`;
+  }
+  const last = pts[pts.length - 1];
+  return `${d} L${last[0]},${last[1]}`;
+}
+
+function Counter({ value, prefix = '', suffix = '', decimals = 0 }) {
+  const { animate: moving } = useShowcaseMotion();
+  const mv = useMotionValue(value);
+  const text = useTransform(mv, (v) => `${prefix}${v.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals })}${suffix}`);
+  useEffect(() => {
+    if (!moving) { mv.jump(value); return; }
+    const c = animate(mv, value, { duration: 0.8, ease: 'easeOut' });
+    return () => c.stop();
+  }, [value, mv, moving]);
+  return <motion.span>{text}</motion.span>;
+}
+
+function seedSeries(n) {
+  const out = [];
+  let v = 60;
+  for (let i = 0; i < n; i++) {
+    v = Math.max(15, Math.min(95, v + (Math.random() - 0.48) * 14));
+    out.push(v);
+  }
+  return out;
+}
+
+const SEGMENTS = [
+  { key: 'segDirect', value: 38, color: '#bfff3c' },
+  { key: 'segSearch', value: 27, color: '#8b7cff' },
+  { key: 'segSocial', value: 21, color: '#ff5d8f' },
+  { key: 'segEmail', value: 14, color: '#4cc9f0' },
+];
+
+function Donut({ t }) {
+  const [hover, setHover] = useState(null);
+  const R = 62;
+  const C = 2 * Math.PI * R;
+  let offset = 0;
+  const total = SEGMENTS.reduce((s, x) => s + x.value, 0);
+  const active = hover != null ? SEGMENTS[hover] : null;
+  return (
+    <div className="flex flex-wrap items-center gap-4">
+      <svg viewBox="0 0 160 160" className="h-36 w-36 shrink-0 -rotate-90" role="img" aria-label={t('donutAria')}>
+        {SEGMENTS.map((s, i) => {
+          const len = (s.value / total) * C;
+          const el = (
+            <motion.circle
+              key={s.key}
+              cx="80"
+              cy="80"
+              r={R}
+              fill="none"
+              stroke={s.color}
+              strokeWidth={hover === i ? 22 : 16}
+              strokeDasharray={`${len - 3} ${C - len + 3}`}
+              strokeDashoffset={-offset}
+              initial={{ opacity: 0 }}
+              animate={{ opacity: hover == null || hover === i ? 1 : 0.3 }}
+              onMouseEnter={() => setHover(i)}
+              onMouseLeave={() => setHover(null)}
+              style={{ cursor: 'pointer', transition: 'stroke-width 0.2s' }}
+            />
+          );
+          offset += len;
+          return el;
+        })}
+        <g className="rotate-90" style={{ transformOrigin: '80px 80px' }}>
+          <text x="80" y="78" textAnchor="middle" fill="#fff" fontSize="22" fontWeight="700">
+            {active ? `${active.value}%` : '100%'}
+          </text>
+          <text x="80" y="96" textAnchor="middle" fill="#9c9ca8" fontSize="9">
+            {active ? t(active.key) : t('segTotal')}
+          </text>
+        </g>
+      </svg>
+      <ul className="space-y-2 text-xs">
+        {SEGMENTS.map((s, i) => (
+          <li
+            key={s.key}
+            onMouseEnter={() => setHover(i)}
+            onMouseLeave={() => setHover(null)}
+            className="text-muted"
+          >
+            <button type="button" aria-pressed={hover === i} onFocus={() => setHover(i)} onClick={() => setHover(i)} className="flex min-h-[36px] items-center gap-2 text-left">
+            <span className="h-2.5 w-2.5 rounded-full" style={{ background: s.color }} />
+            {t(s.key)} · {s.value}%
+            </button>
+          </li>
+        ))}
+      </ul>
+    </div>
+  );
+}
+
+export default function DashboardDemo() {
+  const t = useTranslations('Showcase.ui');
+  const { animate: moving, reducedMotion } = useShowcaseMotion();
+  const areaId = useId();
+  const [range, setRange] = useState('60');
+  const [live, setLive] = useState(true);
+  const [series, setSeries] = useState(() => seedSeries(120));
+  const [hoverIdx, setHoverIdx] = useState(null);
+  const svg = useRef(null);
+
+  useEffect(() => {
+    if (!live || !moving) return undefined;
+    const id = setInterval(() => {
+      setSeries((s) => {
+        const last = s[s.length - 1];
+        const next = Math.max(15, Math.min(95, last + (Math.random() - 0.48) * 14));
+        return [...s.slice(1), next];
+      });
+    }, 1000);
+    return () => clearInterval(id);
+  }, [live, moving]);
+
+  const view = useMemo(() => series.slice(-Number(range)), [series, range]);
+  useEffect(() => setHoverIdx(null), [range]);
+  const pts = useMemo(
+    () =>
+      view.map((v, i) => [
+        PAD.l + (i / (view.length - 1)) * (W - PAD.l - PAD.r),
+        PAD.t + (1 - v / 100) * (H - PAD.t - PAD.b),
+      ]),
+    [view]
+  );
+  const line = smooth(pts);
+  const area = `${line} L${pts[pts.length - 1][0]},${H - PAD.b} L${pts[0][0]},${H - PAD.b} Z`;
+  const current = view[view.length - 1];
+  const avg = view.reduce((a, b) => a + b, 0) / view.length;
+  const peak = Math.max(...view);
+
+  const onMove = (e) => {
+    const r = svg.current.getBoundingClientRect();
+    const x = ((e.clientX - r.left) / r.width) * W;
+    const i = Math.round(((x - PAD.l) / (W - PAD.l - PAD.r)) * (view.length - 1));
+    setHoverIdx(Math.max(0, Math.min(view.length - 1, i)));
+  };
+
+  const hp = hoverIdx != null ? pts[hoverIdx] : null;
+  const bars = useMemo(() => Array.from({ length: 12 }, (_, i) => 30 + Math.abs(Math.sin(i * 1.7 + 1)) * 60), []);
+
+  return (
+    <div className="absolute inset-0 overflow-y-auto p-4 md:p-6" data-lenis-prevent>
+      <div className="mx-auto max-w-5xl space-y-4">
+        <p className="text-sm text-muted">{t('sampleOnly')}</p>
+        <div className="grid grid-cols-2 gap-3 md:grid-cols-4">
+          {[
+            [t('kpiNow'), <Counter key="a" value={current} decimals={1} suffix="%" />],
+            [t('kpiAvg'), <Counter key="b" value={avg} decimals={1} suffix="%" />],
+            [t('kpiPeak'), <Counter key="c" value={peak} decimals={1} suffix="%" />],
+            [t('kpiUsers'), <Counter key="d" value={Math.round(current * 38.4)} />],
