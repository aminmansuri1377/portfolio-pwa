+            <p className="col-span-full text-center text-xs opacity-60">
+              {notify ? t('notifyOn') : t('notifyOff')}
+            </p>
+          </div>
+        </div>
+
+        <AnimatePresence>
+          {open && (
+            <motion.div
+              initial={{ opacity: 0 }}
+              animate={{ opacity: 1 }}
+              exit={{ opacity: 0 }}
+              className="absolute inset-0 z-10 flex items-start justify-center bg-black/60 p-4 pt-[12%] backdrop-blur-sm"
+              onMouseDown={(e) => e.target === e.currentTarget && setOpen(false)}
+            >
+              <motion.div
+                ref={panel}
+                role="dialog"
+                aria-modal="true"
+                aria-label={t('searchPlaceholder')}
+                initial={{ opacity: 0, y: -16, scale: 0.97 }}
+                animate={{ opacity: 1, y: 0, scale: 1 }}
+                exit={{ opacity: 0, y: -10, scale: 0.98 }}
+                transition={{ type: 'spring', stiffness: 420, damping: 32 }}
+                className="w-full max-w-lg overflow-hidden rounded-2xl border border-white/15 bg-ink-900 text-white shadow-2xl"
+              >
+                <div className="flex items-center gap-3 border-b border-white/10 px-4">
+                  <FiSearch className="text-muted" />
+                  <input
+                    ref={input}
+                    role="combobox"
+                    aria-autocomplete="list"
+                    aria-expanded="true"
+                    aria-controls={listId}
+                    aria-activedescendant={results[cursor] ? `${listId}-${results[cursor].id}` : undefined}
+                    value={query}
+                    onChange={(e) => setQuery(e.target.value)}
+                    onKeyDown={onInputKey}
+                    placeholder={t('searchPlaceholder')}
+                    aria-label={t('searchPlaceholder')}
+                    className="h-12 min-w-0 w-full bg-transparent text-base outline-none placeholder:text-muted"
+                  />
+                  <button type="button" onClick={() => setOpen(false)} aria-label={t('close')} className="grid h-10 w-10 shrink-0 place-items-center text-muted"><FiX /></button>
+                </div>
+                <ul id={listId} aria-label={t('searchPlaceholder')} className="max-h-72 overflow-y-auto p-2" role="listbox" data-lenis-prevent>
+                  {results.length === 0 && <li className="px-3 py-6 text-center text-sm text-muted">{t('noResults')}</li>}
+                  {results.map((c, i) => {
+                    const Icon = c.icon;
+                    const showGroup = i === 0 || results[i - 1].group !== c.group;
+                    return (
+                      <li key={c.id} role="presentation">
+                        {showGroup && (
+                          <p className="px-3 pb-1 pt-2 font-mono text-xs uppercase tracking-[0.25em] text-muted">{c.group}</p>
+                        )}
+                        <button
+                          type="button"
+                          role="option"
+                          id={`${listId}-${c.id}`}
+                          tabIndex={-1}
+                          aria-selected={cursor === i}
+                          onMouseEnter={() => setCursor(i)}
+                          onClick={() => {
+                            c.run();
+                            setOpen(false);
+                          }}
+                          className={`flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm transition-colors ${cursor === i ? 'bg-white/10' : ''}`}
+                        >
+                          <Icon size={15} className={cursor === i ? 'text-lime' : 'text-muted'} />
+                          <Highlight text={c.label} idx={c.idx} />
+                        </button>
+                      </li>
+                    );
+                  })}
+                </ul>
+                <div className="flex items-center justify-between border-t border-white/10 px-4 py-2 font-mono text-xs text-muted">
+                  <span>↑↓ {t('navigate')}</span>
+                  <span>↵ {t('select')}</span>
+                  <span>esc {t('close')}</span>
+                </div>
+              </motion.div>
+            </motion.div>
+          )}
+        </AnimatePresence>
+
+        {emailFallback && <label className="absolute bottom-4 inset-x-4 z-20 rounded-xl border border-lime/30 bg-ink-900 p-3 text-sm text-white">{t('copyManually')}<input aria-label={t('cmdCopyEmail')} readOnly value={SITE.email} onFocus={event => event.target.select()} className="mt-2 w-full rounded border border-white/20 bg-transparent p-2 text-base" /></label>}
+        <AnimatePresence>
+          {toast && (
+            <motion.div
+              initial={{ opacity: 0, y: 14 }}
+              animate={{ opacity: 1, y: 0 }}
+              exit={{ opacity: 0, y: 14 }}
+              role="status"
+              className="absolute bottom-4 left-1/2 z-20 -translate-x-1/2 rounded-full bg-lime px-4 py-2 font-mono text-xs font-semibold text-ink-950"
+            >
+              {toast}
+            </motion.div>
+          )}
+        </AnimatePresence>
+      </div>
+    </div>
+  );
+}
diff --git a/components/showcase/demos/PhysicsDemo.jsx b/components/showcase/demos/PhysicsDemo.jsx
new file mode 100644
index 0000000..346dc7c
--- /dev/null
+++ b/components/showcase/demos/PhysicsDemo.jsx
@@ -0,0 +1,240 @@
+import { useEffect, useRef, useState } from 'react';
+import { useTranslations } from 'next-intl';
+import { ActionButton, ChipGroup, Panel } from '../controls';
+import { useShowcaseMotion } from '../Runtime';
+
+const WORDS = ['React', 'Next.js', 'TypeScript', 'Three.js', 'GLSL', 'Framer', 'Tailwind', 'CSS', 'HTML', 'JS', 'Git', 'R3F', 'PWA', 'Vite', 'SVG', 'Canvas'];
+const GRAVITY = { down: [0, 1], none: [0, 0], up: [0, -1] };
+
+export default function PhysicsDemo() {
+  const t = useTranslations('Showcase.ui');
+  const { animate } = useShowcaseMotion();
+  const activeRef = useRef(animate);
+  activeRef.current = animate;
+  const [unavailable, setUnavailable] = useState(false);
+  const canvasRef = useRef(null);
+  const [gravity, setGravity] = useState('down');
+  const gravityRef = useRef('down');
+  const api = useRef({ add: () => {}, shake: () => {}, sync: () => {}, step: () => {} });
+
+  useEffect(() => {
+    gravityRef.current = gravity;
+  }, [gravity]);
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    const ctx = canvas.getContext('2d');
+    if (!ctx) { setUnavailable(true); return; }
+    let repaint = () => {};
+    let w = 0;
+    let h = 0;
+    let raf = 0;
+    const balls = [];
+    const pointer = { x: 0, y: 0, grab: null };
+
+    const resize = () => {
+      const dpr = Math.min(window.devicePixelRatio || 1, 2);
+      w = canvas.clientWidth;
+      h = canvas.clientHeight;
+      canvas.width = Math.max(1, Math.floor(w * dpr));
+      canvas.height = Math.max(1, Math.floor(h * dpr));
+      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      if (!activeRef.current) repaint();
+    };
+    resize();
+
+    const addBall = (label, x, y) => {
+      const r = 24 + Math.min(22, label.length * 3.2);
+      const px = x ?? r + Math.random() * Math.max(10, w - r * 2);
+      const py = y ?? (activeRef.current ? -r - Math.random() * 120 : r + Math.random() * Math.max(10, h - r * 2));
+      balls.push({
+        label,
+        r,
+        x: px,
+        y: py,
+        px: px - (Math.random() - 0.5) * 4,
+        py,
+        hue: Math.random() < 0.5 ? 84 : 255,
+        mass: r * r,
+      });
+    };
+    WORDS.forEach((word, i) => addBall(word, w * (0.15 + 0.7 * ((i * 0.37) % 1)), -40 - i * 55));
+
+    api.current.add = () => {
+      for (let i = 0; i < 4; i++) addBall(WORDS[Math.floor(Math.random() * WORDS.length)]);
+      while (balls.length > 90) balls.shift();
+      if (!activeRef.current) { step(); draw(); }
+    };
+    api.current.shake = () => {
+      balls.forEach((b) => {
+        b.px = b.x - (Math.random() - 0.5) * 60;
+        b.py = b.y - (Math.random() - 0.5) * 60 - 20;
+      });
+      if (!activeRef.current) { step(); draw(); }
+    };
+
+    const ro = new ResizeObserver(resize);
+    ro.observe(canvas);
+
+    const step = () => {
+      const [gx, gy] = GRAVITY[gravityRef.current];
+      const SUB = 3;
+      for (let s = 0; s < SUB; s++) {
+        for (const b of balls) {
+          const vx = (b.x - b.px) * 0.995;
+          const vy = (b.y - b.py) * 0.995;
+          b.px = b.x;
+          b.py = b.y;
+          b.x += vx + gx * 0.22;
+          b.y += vy + gy * 0.22;
+        }
+        if (pointer.grab) {
+          const b = pointer.grab;
+          b.x += (pointer.x - b.x) * 0.35;
+          b.y += (pointer.y - b.y) * 0.35;
+        }
+        for (let i = 0; i < balls.length; i++) {
+          const a = balls[i];
+          for (let j = i + 1; j < balls.length; j++) {
+            const b = balls[j];
+            const dx = b.x - a.x;
+            const dy = b.y - a.y;
+            const min = a.r + b.r;
+            const d2 = dx * dx + dy * dy;
+            if (d2 < min * min && d2 > 0.0001) {
+              const d = Math.sqrt(d2);
+              const overlap = (min - d) / d;
+              const total = a.mass + b.mass;
+              const wa = b.mass / total;
+              const wb = a.mass / total;
+              a.x -= dx * overlap * wa;
+              a.y -= dy * overlap * wa;
+              b.x += dx * overlap * wb;
+              b.y += dy * overlap * wb;
+            }
+          }
+        }
+        for (const b of balls) {
+          // walls (no ceiling, so new balls can drop in)
+          if (b.x < b.r) { b.x = b.r; b.px = b.x + (b.x - b.px) * 0.4; }
+          if (b.x > w - b.r) { b.x = w - b.r; b.px = b.x + (b.x - b.px) * 0.4; }
+          if (b.y > h - b.r) { b.y = h - b.r; b.py = b.y + (b.y - b.py) * 0.35; }
+          if (b.y < b.r && b.py > b.y && gy < 0) { b.y = b.r; b.py = b.y + (b.y - b.py) * 0.35; }
+        }
+      }
+    };
+
+    const draw = () => {
+      ctx.clearRect(0, 0, w, h);
+      for (const b of balls) {
+        const g = ctx.createRadialGradient(b.x - b.r * 0.35, b.y - b.r * 0.4, b.r * 0.1, b.x, b.y, b.r);
+        g.addColorStop(0, `hsla(${b.hue}, 90%, 70%, 0.95)`);
+        g.addColorStop(1, `hsla(${b.hue}, 80%, 38%, 0.9)`);
+        ctx.fillStyle = g;
+        ctx.beginPath();
+        ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.fillStyle = '#060609';
+        ctx.font = `600 ${Math.max(12, b.r * 0.38)}px system-ui, sans-serif`;
+        ctx.textAlign = 'center';
+        ctx.textBaseline = 'middle';
+        ctx.fillText(b.label, b.x, b.y);
+      }
+    };
+
+    repaint = draw;
+    let painted = false;
+    let previous = 0;
+    let carry = 0;
+    const tick = now => {
+      if (!activeRef.current) return;
+      carry += previous ? Math.min((now - previous) / 1000, .05) : 1 / 60;
+      previous = now;
+      while (carry >= 1 / 60) { step(); carry -= 1 / 60; }
+      draw();
+      painted = true;
+      raf = requestAnimationFrame(tick);
+    };
+    api.current.sync = () => {
+      cancelAnimationFrame(raf);
+      previous = 0;
+      carry = 0;
+      if (activeRef.current) raf = requestAnimationFrame(tick);
+      else if (!painted) { for (let i = 0; i < 80; i++) step(); draw(); painted = true; }
+    };
+    api.current.step = () => { step(); draw(); };
+    api.current.sync();
+
+    const local = (e) => {
+      const r = canvas.getBoundingClientRect();
+      pointer.x = e.clientX - r.left;
+      pointer.y = e.clientY - r.top;
+    };
+    const down = (e) => {
+      if (!e.isPrimary) return;
+      local(e);
+      let best = null;
+      let bestD = Infinity;
+      for (const b of balls) {
+        const d = Math.hypot(b.x - pointer.x, b.y - pointer.y);
+        if (d < b.r && d < bestD) {
+          best = b;
+          bestD = d;
+        }
+      }
+      pointer.grab = best;
+      if (best) canvas.setPointerCapture?.(e.pointerId);
+    };
+    const move = e => {
+      local(e);
+      if (!activeRef.current && pointer.grab) {
+        const ball = pointer.grab;
+        ball.x = ball.px = Math.max(ball.r, Math.min(w - ball.r, pointer.x));
+        ball.y = ball.py = Math.max(ball.r, Math.min(h - ball.r, pointer.y));
+        draw();
+      }
+    };
+    const up = e => {
+      if (canvas.hasPointerCapture?.(e.pointerId)) canvas.releasePointerCapture(e.pointerId);
+      pointer.grab = null;
+    };
+    canvas.addEventListener('pointerdown', down);
+    canvas.addEventListener('pointermove', move);
+    canvas.addEventListener('pointerup', up);
+    canvas.addEventListener('pointercancel', up);
+
+    return () => {
+      cancelAnimationFrame(raf);
+      ro.disconnect();
+      canvas.removeEventListener('pointerdown', down);
+      canvas.removeEventListener('pointermove', move);
+      canvas.removeEventListener('pointerup', up);
+      canvas.removeEventListener('pointercancel', up);
+      api.current = { add: () => {}, shake: () => {}, sync: () => {}, step: () => {} };
+    };
+  }, []);
+
+  useEffect(() => api.current.sync(), [animate]);
+
+  return (
+    <div className="absolute inset-0 flex flex-col bg-[radial-gradient(circle_at_50%_100%,rgba(139,124,255,0.18),transparent_60%)]">
+      <div className="relative min-h-[360px] flex-1">
+        {unavailable && <p className="absolute inset-0 grid place-items-center p-6 text-center text-muted">{t('canvasUnavailable')}</p>}
+        <canvas ref={canvasRef} className="h-full w-full touch-none" aria-label={t('physicsAria')} />
+      </div>
+      <div className="shrink-0 p-3">
+        <Panel className="flex flex-wrap items-end gap-x-6 gap-y-3">
+          <ChipGroup
+            label={t('gravity')}
+            value={gravity}
+            onChange={setGravity}
+            options={Object.keys(GRAVITY).map((v) => ({ value: v, label: t(`gravities.${v}`) }))}
+          />
+          <ActionButton onClick={() => api.current.add()}>{t('addBalls')}</ActionButton>
+          <ActionButton onClick={() => api.current.shake()}>{t('shake')}</ActionButton>
+          {!animate && <ActionButton onClick={() => api.current.step()}>{t('stepFrame')}</ActionButton>}
+        </Panel>
+      </div>
+    </div>
+  );
+}
diff --git a/components/showcase/demos/PlanetDemo.jsx b/components/showcase/demos/PlanetDemo.jsx
new file mode 100644
index 0000000..e65e630
--- /dev/null
+++ b/components/showcase/demos/PlanetDemo.jsx
@@ -0,0 +1,230 @@
+import { useEffect, useMemo, useRef, useState } from 'react';
+import { useThree } from '@react-three/fiber';
+import { ManagedCanvas as Canvas, useSceneFrame, FitScene } from '../Graphics';
+import { useShowcaseMotion } from '../Runtime';
+import { OrbitControls, Stars } from '@react-three/drei';
+import { AdditiveBlending, BackSide, Vector3 } from 'three';
+import { useTranslations } from 'next-intl';
+import { ActionButton, Panel, RangeField } from '../controls';
+
+const SUN = new Vector3(5, 2.2, 4).normalize();
+
+const planetVertex = /* glsl */ `
+  uniform vec3 uSun;
+  varying vec3 vPos;
+  varying vec3 vNormalV;
+  varying vec3 vViewPos;
+  varying vec3 vSunV;
+
+  void main() {
+    vPos = position;
+    vNormalV = normalize(normalMatrix * normal);
+    vec4 mv = modelViewMatrix * vec4(position, 1.0);
+    vViewPos = mv.xyz;
+    vSunV = normalize((viewMatrix * vec4(uSun, 0.0)).xyz);
+    gl_Position = projectionMatrix * mv;
+  }
+`;
+
+const planetFragment = /* glsl */ `
+  uniform float uSeed;
+  uniform float uSea;
+  uniform float uTime;
+  varying vec3 vPos;
+  varying vec3 vNormalV;
+  varying vec3 vViewPos;
+  varying vec3 vSunV;
+
+  float hash31(vec3 p) {
+    p = fract(p * 0.3183099 + 0.1);
+    p *= 17.0;
+    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
+  }
+
+  float vnoise(vec3 x) {
+    vec3 i = floor(x);
+    vec3 f = fract(x);
+    f = f * f * (3.0 - 2.0 * f);
+    return mix(
+      mix(mix(hash31(i + vec3(0.0, 0.0, 0.0)), hash31(i + vec3(1.0, 0.0, 0.0)), f.x),
+          mix(hash31(i + vec3(0.0, 1.0, 0.0)), hash31(i + vec3(1.0, 1.0, 0.0)), f.x), f.y),
+      mix(mix(hash31(i + vec3(0.0, 0.0, 1.0)), hash31(i + vec3(1.0, 0.0, 1.0)), f.x),
+          mix(hash31(i + vec3(0.0, 1.0, 1.0)), hash31(i + vec3(1.0, 1.0, 1.0)), f.x), f.y),
+      f.z);
+  }
+
+  float fbm(vec3 p) {
+    float v = 0.0;
+    float a = 0.5;
+    for (int i = 0; i < 6; i++) {
+      v += a * vnoise(p);
+      p = p * 2.03 + vec3(11.3, 5.7, 3.1);
+      a *= 0.5;
+    }
+    return v;
+  }
+
+  void main() {
+    vec3 dir = normalize(vPos);
+    vec3 p = dir * 1.7 + vec3(uSeed * 7.13, uSeed * 3.71, uSeed * 5.37);
+    float h = fbm(p);
+
+    vec3 deep = vec3(0.02, 0.07, 0.2);
+    vec3 shallow = vec3(0.06, 0.32, 0.5);
+    vec3 sand = vec3(0.76, 0.69, 0.45);
+    vec3 grass = vec3(0.18, 0.42, 0.16);
+    vec3 rock = vec3(0.36, 0.31, 0.27);
+    vec3 snow = vec3(0.95, 0.97, 1.0);
+
+    vec3 col;
+    float water = 0.0;
+    if (h < uSea) {
+      water = 1.0;
+      col = mix(deep, shallow, smoothstep(uSea - 0.18, uSea, h));
+    } else {
+      float e = (h - uSea) / (1.0 - uSea);
+      col = mix(sand, grass, smoothstep(0.0, 0.08, e));
+      col = mix(col, rock, smoothstep(0.35, 0.6, e));
+      col = mix(col, snow, smoothstep(0.62, 0.8, e));
+    }
+    // polar caps
+    float lat = abs(dir.y) + (fbm(p * 2.0) - 0.5) * 0.18;
+    col = mix(col, snow, smoothstep(0.8, 0.93, lat));
+
+    vec3 n = normalize(vNormalV);
+    vec3 V = normalize(-vViewPos);
+    float ndl = dot(n, vSunV);
+    float diff = max(ndl, 0.0);
+
+    vec3 H = normalize(vSunV + V);
+    float spec = pow(max(dot(n, H), 0.0), 70.0) * water * 0.9;
+
+    vec3 lit = col * (0.05 + diff * 1.15) + spec;
+
+    // slowly drifting clouds
+    float c = fbm(dir * 3.4 + vec3(uTime * 0.02, 0.0, uSeed));
+    c = smoothstep(0.52, 0.78, c);
+    lit = mix(lit, vec3(1.0) * (0.06 + diff), c * 0.7);
+
+    // atmospheric rim
+    float rim = pow(1.0 - max(dot(n, V), 0.0), 3.0);
+    lit += vec3(0.25, 0.5, 1.0) * rim * (0.12 + diff * 0.6);
+
+    gl_FragColor = vec4(lit, 1.0);
+    #include <colorspace_fragment>
+  }
+`;
+
+const atmoVertex = /* glsl */ `
+  varying vec3 vNormalV;
+  void main() {
+    vNormalV = normalize(normalMatrix * normal);
+    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
+  }
+`;
+
+const atmoFragment = /* glsl */ `
+  uniform vec3 uSun;
+  varying vec3 vNormalV;
+  void main() {
+    vec3 n = normalize(vNormalV);
+    vec3 sunV = normalize((viewMatrix * vec4(uSun, 0.0)).xyz);
+    float intensity = pow(max(0.62 - dot(n, vec3(0.0, 0.0, 1.0)), 0.0), 3.0);
+    float day = 0.3 + 0.7 * smoothstep(-0.4, 0.5, dot(n, sunV));
+    gl_FragColor = vec4(vec3(0.28, 0.55, 1.0) * min(intensity * 2.2, 1.6) * day, 1.0);
+  }
+`;
+
+function Planet({ seed, sea }) {
+  const mesh = useRef();
+  const moon = useRef();
+  const invalidate = useThree(state => state.invalidate);
+  const uniforms = useMemo(
+    () => ({ uSun: { value: SUN }, uSeed: { value: 0 }, uSea: { value: 0.5 }, uTime: { value: 0 } }),
+    []
+  );
+  const atmoUniforms = useMemo(() => ({ uSun: { value: SUN } }), []);
+
+  useEffect(() => {
+    uniforms.uSeed.value = seed;
+    invalidate();
+  }, [seed, uniforms, invalidate]);
+  useEffect(() => {
+    uniforms.uSea.value = sea;
+    invalidate();
+  }, [sea, uniforms, invalidate]);
+
+  useSceneFrame((state, delta, elapsed, animate) => {
+    uniforms.uTime.value = elapsed;
+    if (mesh.current) mesh.current.rotation.y += delta * 0.06;
+    if (moon.current) {
+      const a = elapsed * 0.25;
+      moon.current.position.set(Math.cos(a) * 2.5, Math.sin(a * 0.7) * 0.35, Math.sin(a) * 2.5);
+      moon.current.rotation.y += delta * 0.2;
+    }
+  });
+
+  return (
+    <group rotation={[0.35, 0, 0.2]}>
+      <mesh ref={mesh}>
+        <sphereGeometry args={[1, 96, 96]} />
+        <shaderMaterial uniforms={uniforms} vertexShader={planetVertex} fragmentShader={planetFragment} />
+      </mesh>
+      <mesh scale={1.16}>
+        <sphereGeometry args={[1, 64, 64]} />
+        <shaderMaterial
+          uniforms={atmoUniforms}
+          vertexShader={atmoVertex}
+          fragmentShader={atmoFragment}
+          side={BackSide}
+          blending={AdditiveBlending}
+          transparent
+          depthWrite={false}
+        />
+      </mesh>
+      <mesh ref={moon} scale={0.24} position={[2.5, 0, 0]}>
+        <icosahedronGeometry args={[1, 3]} />
+        <meshStandardMaterial color="#a4a4b2" roughness={1} flatShading />
+      </mesh>
+    </group>
+  );
+}
+
+export default function PlanetDemo() {
+  const t = useTranslations('Showcase.ui');
+  const { animate } = useShowcaseMotion();
+  const [seed, setSeed] = useState(0.37);
+  const [sea, setSea] = useState(0.5);
+
+  return (
+    <div className="absolute inset-0 flex flex-col">
+      <div className="relative min-h-[300px] flex-1">
+      <Canvas dpr={[1, 1.6]} camera={{ position: [0, 0.5, 4.4], fov: 42 }}>
+        <color attach="background" args={['#030307']} />
+        <ambientLight intensity={0.12} />
+        <directionalLight position={SUN.clone().multiplyScalar(10).toArray()} intensity={2.2} />
+        <Stars radius={60} depth={40} count={3500} factor={3.2} saturation={0} fade speed={animate ? .6 : 0} />
+        <FitScene radius={2.85} position={[0, .5, 4.4]} />
+        <Planet seed={seed} sea={sea} />
+        <OrbitControls enablePan={false} minDistance={2.4} maxDistance={22} />
+      </Canvas>
+      </div>
+      <div className="shrink-0 p-3">
+        <Panel className="pointer-events-auto flex w-full max-w-xl flex-wrap items-end gap-x-6 gap-y-3">
+          <div className="min-w-[180px] flex-1">
+            <RangeField
+              label={t('seaLevel')}
+              min={0.35}
+              max={0.65}
+              step={0.005}
+              value={sea}
+              onChange={setSea}
+              format={(v) => `${Math.round(v * 100)}%`}
+            />
+          </div>
+          <ActionButton onClick={() => setSeed(Math.random() * 20)}>{t('newPlanet')}</ActionButton>
+        </Panel>
+      </div>
+    </div>
+  );
+}
diff --git a/components/showcase/demos/ThemeDemo.jsx b/components/showcase/demos/ThemeDemo.jsx
new file mode 100644
index 0000000..2819b50
--- /dev/null
+++ b/components/showcase/demos/ThemeDemo.jsx
@@ -0,0 +1,156 @@
+import { useEffect, useMemo, useRef, useState } from 'react';
+import { motion } from 'framer-motion';
+import { FiCheck, FiCopy } from 'react-icons/fi';
+import { useTranslations } from 'next-intl';
+import { ActionButton, ChipGroup, RangeField } from '../controls';
+
+const DENSITY = { compact: 0.75, cozy: 1, roomy: 1.3 };
+
+function contrastColor(hue, saturation) {
+  const lightness = .62;
+  const a = (saturation / 100) * Math.min(lightness, 1 - lightness);
+  const channel = n => { const k = (n + hue / 30) % 12; const v = lightness - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)); return v <= .04045 ? v / 12.92 : Math.pow((v + .055) / 1.055, 2.4); };
+  const luminance = .2126 * channel(0) + .7152 * channel(8) + .0722 * channel(4);
+  return (luminance + .05) / .05 > 1.05 / (luminance + .05) ? '#060609' : '#ffffff';
+}
+
+export default function ThemeDemo() {
+  const t = useTranslations('Showcase.ui');
+  const [hue, setHue] = useState(84);
+  const [sat, setSat] = useState(100);
+  const [radius, setRadius] = useState(14);
+  const [density, setDensity] = useState('cozy');
+  const [mode, setMode] = useState('dark');
+  const [copied, setCopied] = useState(false);
+  const [manualCopy, setManualCopy] = useState(false);
+  const [saved, setSaved] = useState(false);
+  const [email, setEmail] = useState('hello@northwind.dev');
+  const timer = useRef();
+  useEffect(() => () => clearTimeout(timer.current), []);
+
+  const tokens = useMemo(() => {
+    const dark = mode === 'dark';
+    return {
+      '--accent': `hsl(${hue} ${sat}% 62%)`,
+      '--accent-contrast': contrastColor(hue, sat),
+      '--bg': dark ? '#0c0c12' : '#f6f6f2',
+      '--surface': dark ? '#14141c' : '#ffffff',
+      '--text': dark ? '#f4f4f0' : '#15151c',
+      '--muted': dark ? '#9c9ca8' : '#6b6b78',
+      '--line': dark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)',
+      '--radius': `${radius}px`,
+      '--space': `${Math.round(16 * DENSITY[density])}px`,
+    };
+  }, [hue, sat, radius, density, mode]);
+
+  const css = `:root {\n${Object.entries(tokens)
+    .map(([k, v]) => `  ${k}: ${v};`)
+    .join('\n')}\n}`;
+
+  const copy = async () => {
+    try {
+      await navigator.clipboard.writeText(css);
+      setCopied(true);
+      clearTimeout(timer.current);
+      timer.current = setTimeout(() => setCopied(false), 1600);
+    } catch (e) {
+      setManualCopy(true);
+    }
+  };
+
+  const bars = [42, 68, 51, 84, 63, 92, 74];
+
+  return (
+    <div className="absolute inset-0 overflow-y-auto p-4 md:p-6" data-lenis-prevent>
+      <div className="mx-auto grid max-w-6xl gap-4 lg:grid-cols-[300px_1fr]">
+        <div className="min-w-0 space-y-5 rounded-2xl border border-white/10 bg-ink-900/80 p-4">
+          <RangeField label={t('hue')} min={0} max={360} value={hue} onChange={setHue} format={(v) => `${v}°`} />
+          <RangeField label={t('saturation')} min={20} max={100} value={sat} onChange={setSat} format={(v) => `${v}%`} />
+          <RangeField label={t('radius')} min={0} max={30} value={radius} onChange={setRadius} format={(v) => `${v}px`} />
+          <ChipGroup
+            label={t('density')}
+            value={density}
+            onChange={setDensity}
+            options={Object.keys(DENSITY).map((v) => ({ value: v, label: t(`densities.${v}`) }))}
+          />
+          <ChipGroup
+            label={t('mode')}
+            value={mode}
+            onChange={setMode}
+            options={['dark', 'light'].map((v) => ({ value: v, label: t(`modes.${v}`) }))}
+          />
+          <pre className="max-h-52 overflow-auto rounded-xl bg-black/40 p-3 font-mono text-xs leading-relaxed text-lime/90">{css}</pre>
+          <ActionButton onClick={copy} className="inline-flex items-center gap-2">
+            {copied ? <FiCheck /> : <FiCopy />} {copied ? t('copied') : t('copyCss')}
+          </ActionButton>
+          {manualCopy && <label className="block text-sm text-muted">{t('copyManually')}<textarea aria-label={t('copyCss')} value={css} readOnly onFocus={event => event.target.select()} rows={8} className="mt-2 w-full rounded-lg border border-white/15 bg-black/30 p-3 font-mono text-sm" /></label>}
+        </div>
+
+        {/* preview — every value comes from the CSS variables above */}
+        <div
+          style={{ ...tokens, background: 'var(--bg)', color: 'var(--text)', borderRadius: 'calc(var(--radius) + 6px)', padding: 'var(--space)' }}
+          className="min-w-0 border transition-colors duration-300"
+        >
+          <div className="flex items-center justify-between" style={{ marginBottom: 'var(--space)' }}>
+            <p className="font-display text-lg font-bold">Northwind<span style={{ color: 'var(--accent)' }}>.</span></p>
+            <div className="flex gap-2">
+              <span className="px-3 py-1 text-xs font-semibold" style={{ background: 'var(--accent)', color: 'var(--accent-contrast)', borderRadius: 'var(--radius)' }}>
+                {t('badge')}
+              </span>
+            </div>
+          </div>
+
+          <div className="grid gap-[var(--space)] md:grid-cols-3" style={{ '--space': tokens['--space'] }}>
+            {[
+              ['2.4k', t('statUsers')],
+              ['98%', t('statUptime')],
+              ['$18k', t('statRevenue')],
+            ].map(([v, l]) => (
+              <div key={l} style={{ background: 'var(--surface)', border: '1px solid var(--line)', borderRadius: 'var(--radius)', padding: 'var(--space)' }}>
+                <p className="text-xs" style={{ color: 'var(--muted)' }}>{l}</p>
+                <p className="mt-1 font-display text-2xl font-bold">{v}</p>
+              </div>
+            ))}
+          </div>
+
+          <div className="mt-[var(--space)] grid gap-[var(--space)] md:grid-cols-[1.4fr_1fr]" style={{ '--space': tokens['--space'] }}>
+            <div style={{ background: 'var(--surface)', border: '1px solid var(--line)', borderRadius: 'var(--radius)', padding: 'var(--space)' }}>
+              <p className="text-sm font-semibold">{t('chartTitle')}</p>
+              <div className="mt-4 flex h-32 items-end gap-2">
+                {bars.map((b, i) => (
+                  <motion.div
+                    key={i}
+                    layout
+                    animate={{ height: `${b}%` }}
+                    transition={{ type: 'spring', stiffness: 120, damping: 14, delay: i * 0.03 }}
+                    className="flex-1"
+                    style={{ background: i === 5 ? 'var(--accent)' : 'var(--line)', borderRadius: 'calc(var(--radius) / 2.5)' }}
+                  />
+                ))}
+              </div>
+            </div>
+            <div className="flex flex-col gap-3" style={{ background: 'var(--surface)', border: '1px solid var(--line)', borderRadius: 'var(--radius)', padding: 'var(--space)' }}>
+              <input
+                value={email}
+                onChange={event => { setEmail(event.target.value); setSaved(false); }}
+                aria-label="email"
+                className="w-full bg-transparent px-3 py-2 text-base outline-none"
+                style={{ border: '1px solid var(--line)', borderRadius: 'var(--radius)' }}
+              />
+              <div className="h-2 overflow-hidden" style={{ background: 'var(--line)', borderRadius: 999 }}>
+                <div className="h-full w-2/3" style={{ background: 'var(--accent)' }} />
+              </div>
+              <button type="button" onClick={() => setSaved(true)} className="min-h-[44px] px-4 py-2 text-sm font-semibold" style={{ background: 'var(--accent)', color: 'var(--accent-contrast)', borderRadius: 'var(--radius)' }}>
+                {t('primaryAction')}
+              </button>
+              <button type="button" onClick={() => { setHue(84); setSat(100); setRadius(14); setDensity('cozy'); setMode('dark'); setEmail('hello@northwind.dev'); setSaved(false); }} className="min-h-[44px] px-4 py-2 text-sm font-semibold" style={{ border: '1px solid var(--line)', borderRadius: 'var(--radius)' }}>
+                {t('resetTheme')}
+              </button>
+              <p role="status" className="text-sm" style={{ color: 'var(--muted)' }}>{saved ? t('themeSaved') : t('sampleOnly')}</p>
+            </div>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
