+/* The supplied ring tunnel is the hero backdrop; the original collection stays intact. */
+.tunnelHero { position: relative; display: flex; align-items: center; min-height: 88svh; padding: 142px 0 54px; isolation: isolate; background: #060609; }
+.tunnelBackground { position: absolute; inset: 0; opacity: .78; z-index: -2; }
+.tunnelVignette { position: absolute; inset: 0; pointer-events: none; z-index: -1; background: radial-gradient(ellipse at center,transparent 14%,#060609 76%); }
+.tunnelContent { text-align: center; }
+.tunnelKicker { color: #bfff3c; font: 400 .8125rem var(--font-mono),monospace; letter-spacing: .3em; }
+.tunnelTitle { margin: 26px 0 0; display: flex; justify-content: center; gap: .2em; font: 700 clamp(3.5rem,10.5vw,9rem)/.98 var(--font-display),sans-serif; letter-spacing: -.055em; }
+.tunnelTitle > span { display: inline-flex; }
+.tunnelTitle > span > span { display: inline-block; }
+.gradientWord { color: #bfff3c; }
+.gradientWord > span { background: linear-gradient(145deg,#bfff3c,#8b7cff); background-clip: text; -webkit-background-clip: text; color: transparent; }
+.tunnelIntro { max-width: 650px; margin: 29px auto 0; font-size: clamp(1rem,1.6vw,1.2rem); line-height: 1.85; color: #b4b3bf; text-wrap: pretty; }
+.tunnelButtons { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 13px 26px; margin-top: 32px; }
+.tunnelButtons .primaryButton { border-radius: 100px; }
+.tunnelStats { display: flex; flex-wrap: wrap; justify-content: center; gap: 32px 58px; margin: 43px auto 27px; }
+.tunnelStats > div { display: grid; gap: 7px; }
+.tunnelStats strong { font: 600 1.85rem var(--font-display),sans-serif; color: #f0f0f0; }
+.tunnelStats span { font: 400 .75rem var(--font-mono),monospace; color: #9c9ca8; letter-spacing: .05em; }
+.tunnelContent > .motionButton { margin: 0 auto; padding: 12px; min-height: 44px; }
+.importedArtwork { position: absolute; inset: 0; transition: transform .55s; background: radial-gradient(ellipse at center,#171323,#08090e); }
+.cardButton:hover .importedArtwork { transform: scale(1.04); }
