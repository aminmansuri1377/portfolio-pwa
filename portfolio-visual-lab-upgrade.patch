+    const a = k * Math.PI * 2 * turns + (i % 3) * 2.09;
+    const r = r0 + (r1 - r0) * k;
+    return { x: 100 + Math.cos(a) * r, y: 62 + Math.sin(a) * r * 0.55, o: 0.25 + (1 - k) * 0.75, r: 0.8 + (1 - k) * 1.6 };
