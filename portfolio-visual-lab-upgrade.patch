+      <path d="M10 90 Q 35 40 60 64 T 110 50 T 160 70 T 190 30" fill="none" stroke={accent} strokeWidth="2" className={s.dash} />
+    </svg>
+  ),
+};
+
+export default function Thumb({ id, accent }) {
+  const Art = ART[id];
