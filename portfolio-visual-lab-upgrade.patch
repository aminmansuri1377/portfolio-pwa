+    <div ref={ref} data-active={inView ? 'true' : 'false'} className={`${s.poster} relative h-full w-full overflow-hidden bg-[radial-gradient(circle_at_50%_0%,rgba(255,255,255,0.06),transparent_60%)]`}>
