index 0000000..b80af68
--- /dev/null
+++ b/components/showcase/demos/MicroDemo.jsx
@@ -0,0 +1,261 @@
+import { useEffect, useRef, useState } from 'react';
+import { motion, useMotionValue, useSpring, useTransform } from 'framer-motion';
+import { useTranslations } from 'next-intl';
+import { useShowcaseMotion } from '../Runtime';
+
+function Cell({ title, children, className = '' }) {
+  return (
+    <div className={`relative flex min-h-[230px] flex-col rounded-2xl border border-white/10 bg-ink-900/70 p-4 ${className}`}>
+      <p className="font-mono text-xs uppercase tracking-[0.25em] text-muted">{title}</p>
+      <div className="flex flex-1 items-center justify-center py-4">{children}</div>
+    </div>
+  );
+}
+
+function Magnetic() {
+  const { animate } = useShowcaseMotion();
+  const t = useTranslations('Showcase.ui');
+  const ref = useRef(null);
+  const x = useSpring(useMotionValue(0), { stiffness: 220, damping: 14, mass: 0.4 });
+  const y = useSpring(useMotionValue(0), { stiffness: 220, damping: 14, mass: 0.4 });
+  useEffect(() => { if (!animate) { x.jump(0); y.jump(0); } }, [animate, x, y]);
+
+  const move = (e) => {
+    if (!animate) return;
+    const r = ref.current.getBoundingClientRect();
+    x.set((e.clientX - (r.left + r.width / 2)) * 0.45);
+    y.set((e.clientY - (r.top + r.height / 2)) * 0.45);
+  };
+  const leave = () => {
+    x.set(0);
+    y.set(0);
+  };
+
+  return (
+    <div className="grid h-40 w-full place-items-center" onPointerMove={move} onPointerLeave={leave}>
+      <motion.button
+        ref={ref}
+        style={{ x, y }}
+        type="button"
+        whileTap={animate ? { scale: 0.92 } : undefined}
+        className="rounded-full bg-lime px-8 py-4 font-display text-sm font-bold text-ink-950 shadow-glow"
+      >
+        <motion.span style={{ x: useTransform(x, (v) => v * 0.35), y: useTransform(y, (v) => v * 0.35) }} className="block">
+          {t('magnetic')}
+        </motion.span>
+      </motion.button>
+    </div>
+  );
+}
+
+function Tilt() {
+  const { animate } = useShowcaseMotion();
+  const t = useTranslations('Showcase.ui');
+  const ref = useRef(null);
+  const px = useMotionValue(0.5);
+  const py = useMotionValue(0.5);
+  const sx = useSpring(px, { stiffness: 200, damping: 20 });
+  const sy = useSpring(py, { stiffness: 200, damping: 20 });
+  useEffect(() => { if (!animate) { px.set(.5); py.set(.5); sx.jump(.5); sy.jump(.5); } }, [animate, px, py, sx, sy]);
+  const rotateY = useTransform(sx, [0, 1], [-16, 16]);
+  const rotateX = useTransform(sy, [0, 1], [14, -14]);
+  const glare = useTransform([sx, sy], ([a, b]) => `radial-gradient(circle at ${a * 100}% ${b * 100}%, rgba(255,255,255,0.28), transparent 55%)`);
+
+  const move = (e) => {
+    if (!animate) return;
+    const r = ref.current.getBoundingClientRect();
+    px.set((e.clientX - r.left) / r.width);
+    py.set((e.clientY - r.top) / r.height);
+  };
+  const leave = () => {
+    px.set(0.5);
+    py.set(0.5);
+  };
+
+  return (
+    <div className="[perspective:800px]" onPointerMove={move} onPointerLeave={leave}>
+      <motion.div
+        ref={ref}
+        style={{ rotateX, rotateY, transformStyle: 'preserve-3d' }}
+        className="relative h-40 w-64 overflow-hidden rounded-2xl border border-white/15 bg-gradient-to-br from-violet/60 via-ink-800 to-lime/40 p-5"
+      >
+        <motion.div style={{ background: glare }} className="pointer-events-none absolute inset-0" />
+        <div style={{ transform: 'translateZ(40px)' }}>
+          <p className="font-mono text-xs uppercase tracking-widest text-white/70">{t('tiltKicker')}</p>
+          <p className="mt-2 font-display text-2xl font-bold leading-tight">{t('tilt')}</p>
+        </div>
+      </motion.div>
+    </div>
+  );
+}
+
+function Spotlight() {
+  const t = useTranslations('Showcase.ui');
+  const wrap = useRef(null);
+  const onMove = (e) => {
+    const cards = wrap.current.querySelectorAll('[data-card]');
+    cards.forEach((c) => {
+      const r = c.getBoundingClientRect();
+      c.style.setProperty('--mx', `${e.clientX - r.left}px`);
+      c.style.setProperty('--my', `${e.clientY - r.top}px`);
+    });
+  };
+  return (
+    <div ref={wrap} onPointerMove={onMove} className="grid w-full grid-cols-3 gap-2">
+      {[1, 2, 3].map((i) => (
+        <div
+          key={i}
+          data-card
+          className="relative h-28 overflow-hidden rounded-xl border border-white/10 bg-ink-800 p-3"
+          style={{
+            backgroundImage:
+              'radial-gradient(160px circle at var(--mx, -200px) var(--my, -200px), rgba(191,255,60,0.22), transparent 70%)',
+          }}
+        >
+          <p className="font-mono text-xs text-lime">0{i}</p>
+          <p className="mt-6 font-display text-sm font-semibold">{t(`spot${i}`)}</p>
+        </div>
+      ))}
+    </div>
+  );
+}
+
+const GLYPHS = '!<>-_\\/[]{}—=+*^?#________';
+
+function Scramble() {
+  const { animate } = useShowcaseMotion();
+  const t = useTranslations('Showcase.ui');
+  const target = t('scrambleText');
+  const [text, setText] = useState(target);
+  const raf = useRef(0);
+
+  useEffect(() => {
+    setText(target);
+    return () => cancelAnimationFrame(raf.current);
+  }, [target, animate]);
+
+  const run = () => {
+    cancelAnimationFrame(raf.current);
+    if (!animate) { setText(target); return; }
+    const start = performance.now();
+    const duration = 900;
+    const tick = (now) => {
+      const p = Math.min(1, (now - start) / duration);
+      const out = target
+        .split('')
+        .map((ch, i) => {
+          if (ch === ' ') return ' ';
+          if (i / target.length < p) return ch;
+          return GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
+        })
+        .join('');
+      setText(out);
+      if (p < 1) raf.current = requestAnimationFrame(tick);
+    };
+    raf.current = requestAnimationFrame(tick);
+  };
+
+  return (
+    <button
+      type="button"
+      onClick={run}
+      onPointerEnter={run}
+      onFocus={run}
+      aria-label={target}
+      className="text-center font-display text-3xl font-bold tracking-tight text-gradient"
+    >
+      <span aria-hidden>{text}</span>
+    </button>
+  );
+}
+
+function Toggle() {
+  const t = useTranslations('Showcase.ui');
+  const [on, setOn] = useState(false);
+  return (
+    <button
+      type="button"
+      role="switch"
+      aria-label={t('cellToggle')}
+      aria-checked={on}
+      onClick={() => setOn((v) => !v)}
+      className={`flex h-16 w-32 items-center rounded-full border p-2 transition-colors ${
+        on ? 'border-lime/60 bg-lime/20' : 'border-white/15 bg-white/5'
+      }`}
+    >
+      <motion.span
+        layout
+        transition={{ type: 'spring', stiffness: 500, damping: 28 }}
+        className={`grid h-12 w-12 place-items-center rounded-full font-mono text-xs font-bold ${
+          on ? 'ml-auto bg-lime text-ink-950' : 'bg-white/80 text-ink-950'
+        }`}
+      >
+        {on ? t('on') : t('off')}
+      </motion.span>
+    </button>
+  );
+}
+
+function Ripple() {
+  const { animate } = useShowcaseMotion();
+  const t = useTranslations('Showcase.ui');
+  const [ripples, setRipples] = useState([]);
+  const timers = useRef(new Set());
+  useEffect(() => { const pending = timers.current; return () => pending.forEach(clearTimeout); }, []);
+  useEffect(() => { if (!animate) setRipples([]); }, [animate]);
+  const click = (e) => {
+    if (!animate) return;
+    const r = e.currentTarget.getBoundingClientRect();
+    const id = Math.random();
+    setRipples((l) => [...l.slice(-9), { id, x: e.detail ? e.clientX - r.left : r.width / 2, y: e.detail ? e.clientY - r.top : r.height / 2 }]);
+    const timer = setTimeout(() => { setRipples((l) => l.filter((q) => q.id !== id)); timers.current.delete(timer); }, 700);
+    timers.current.add(timer);
+  };
+  return (
+    <button
+      type="button"
+      onClick={click}
+      className="relative overflow-hidden rounded-xl border border-violet/50 bg-violet/20 px-10 py-5 font-display text-sm font-semibold"
+    >
+      {t('ripple')}
+      {ripples.map((r) => (
+        <motion.span
+          key={r.id}
+          initial={{ scale: 0, opacity: 0.55 }}
+          animate={{ scale: 14, opacity: 0 }}
+          transition={{ duration: 0.7, ease: 'easeOut' }}
+          className="pointer-events-none absolute h-8 w-8 rounded-full bg-white"
+          style={{ left: r.x - 16, top: r.y - 16 }}
+        />
+      ))}
+    </button>
+  );
+}
+
+export default function MicroDemo() {
+  const t = useTranslations('Showcase.ui');
+  return (
+    <div className="absolute inset-0 overflow-y-auto p-4 md:p-8" data-lenis-prevent>
+      <div className="mx-auto grid max-w-5xl gap-4 md:grid-cols-3">
+        <Cell title={t('cellMagnetic')}>
+          <Magnetic />
+        </Cell>
+        <Cell title={t('cellTilt')}>
+          <Tilt />
+        </Cell>
+        <Cell title={t('cellToggle')}>
+          <Toggle />
+        </Cell>
+        <Cell title={t('cellSpotlight')} className="md:col-span-2">
+          <Spotlight />
+        </Cell>
+        <Cell title={t('cellRipple')}>
+          <Ripple />
+        </Cell>
+        <Cell title={t('cellScramble')} className="md:col-span-3">
+          <Scramble />
+        </Cell>
+      </div>
+    </div>
+  );
+}
diff --git a/components/showcase/demos/MorphDemo.jsx b/components/showcase/demos/MorphDemo.jsx
new file mode 100644
index 0000000..c6e5e37
--- /dev/null
+++ b/components/showcase/demos/MorphDemo.jsx
@@ -0,0 +1,167 @@
+import { useEffect, useMemo, useRef, useState } from 'react';
+import { useThree } from '@react-three/fiber';
+import { ManagedCanvas as Canvas, useSceneFrame, FitScene } from '../Graphics';
+import { AdditiveBlending, Color, MathUtils } from 'three';
+import { useTranslations } from 'next-intl';
+import { ChipGroup, Panel } from '../controls';
+
+const COUNT = 9000;
+const TAU = Math.PI * 2;
+
+// Each generator writes the position of particle `i` into out[o..o+2].
+const GENERATORS = {
+  sphere(i, out, o) {
+    const k = i + 0.5;
+    const phi = Math.acos(1 - (2 * k) / COUNT);
+    const theta = Math.PI * (1 + Math.sqrt(5)) * k;
+    const r = 1.7;
+    out[o] = Math.cos(theta) * Math.sin(phi) * r;
+    out[o + 1] = Math.cos(phi) * r;
+    out[o + 2] = Math.sin(theta) * Math.sin(phi) * r;
+  },
+  torus(i, out, o) {
+    const u = Math.random() * TAU;
+    const v = Math.random() * TAU;
+    const R = 1.5;
+    const r = 0.58;
+    out[o] = (R + r * Math.cos(v)) * Math.cos(u);
+    out[o + 1] = r * Math.sin(v);
+    out[o + 2] = (R + r * Math.cos(v)) * Math.sin(u);
+  },
+  cube(i, out, o) {
+    const s = 1.45;
+    const a = Math.floor(Math.random() * 3);
+    const sign = Math.random() < 0.5 ? -1 : 1;
+    const p = [(Math.random() * 2 - 1) * s, (Math.random() * 2 - 1) * s, (Math.random() * 2 - 1) * s];
+    p[a] = sign * s;
+    out[o] = p[0];
+    out[o + 1] = p[1];
+    out[o + 2] = p[2];
+  },
+  helix(i, out, o) {
+    const t = (i / COUNT) * 2 - 1;
+    const strand = i % 3;
+    const a = t * Math.PI * 5;
+    const r = 0.95;
+    if (strand === 2) {
+      // rungs between the two strands
+      const k = Math.random() * 2 - 1;
+      out[o] = Math.cos(a) * r * k;
+      out[o + 1] = t * 2.4;
+      out[o + 2] = Math.sin(a) * r * k;
+    } else {
+      const ph = strand === 0 ? 0 : Math.PI;
+      out[o] = Math.cos(a + ph) * r + (Math.random() - 0.5) * 0.08;
+      out[o + 1] = t * 2.4;
+      out[o + 2] = Math.sin(a + ph) * r + (Math.random() - 0.5) * 0.08;
+    }
+  },
+  heart(i, out, o) {
+    const t = Math.random() * TAU;
+    const fill = Math.sqrt(Math.random());
+    const x = 16 * Math.pow(Math.sin(t), 3);
+    const y = 13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t);
+    const s = 0.105 * fill;
+    out[o] = x * s;
+    out[o + 1] = y * s + 0.1;
+    out[o + 2] = (Math.random() - 0.5) * 1.1 * Math.sqrt(1 - fill * fill + 0.05);
+  },
+};
+
+function build(name) {
+  const arr = new Float32Array(COUNT * 3);
+  for (let i = 0; i < COUNT; i++) GENERATORS[name](i, arr, i * 3);
+  return arr;
+}
+
+function Particles({ shape }) {
+  const points = useRef();
+  const group = useRef();
+  const invalidate = useThree(state => state.invalidate);
+  const target = useMemo(() => build(shape), [shape]);
+
+  useEffect(() => { invalidate(); }, [target, invalidate]);
+
+  const { positions, colors, speeds } = useMemo(() => {
+    const positions = build('sphere');
+    const colors = new Float32Array(COUNT * 3);
+    const speeds = new Float32Array(COUNT);
+    const a = new Color('#bfff3c');
+    const b = new Color('#8b7cff');
+    const c = new Color();
+    for (let i = 0; i < COUNT; i++) {
+      c.copy(a).lerp(b, Math.random());
+      colors[i * 3] = c.r;
+      colors[i * 3 + 1] = c.g;
+      colors[i * 3 + 2] = c.b;
+      speeds[i] = 0.025 + Math.random() * 0.06;
+    }
+    return { positions, colors, speeds };
+  }, []);
+
+  useSceneFrame((state, delta, elapsed, animate) => {
+    const tgt = target;
+    if (!tgt || !points.current) return;
+    const t = elapsed;
+    for (let i = 0; i < COUNT; i++) {
+      const k = animate ? 1 - Math.pow(1 - speeds[i], delta * 60) : 1;
+      const i3 = i * 3;
+      positions[i3] += (tgt[i3] - positions[i3]) * k;
+      positions[i3 + 1] += (tgt[i3 + 1] - positions[i3 + 1]) * k;
+      positions[i3 + 2] += (tgt[i3 + 2] - positions[i3 + 2]) * k;
+    }
+    // gentle shimmer so a settled shape still feels alive
+    points.current.material.size = 0.04 + Math.sin(t * 2) * 0.004;
+    points.current.geometry.attributes.position.needsUpdate = true;
+    group.current.rotation.y += delta * 0.18;
+    group.current.rotation.x = MathUtils.lerp(group.current.rotation.x, -state.pointer.y * 0.5, animate ? .05 : 1);
+    group.current.rotation.z = MathUtils.lerp(group.current.rotation.z, state.pointer.x * 0.25, animate ? .05 : 1);
+  });
+
+  return (
+    <group ref={group}>
+      <points ref={points} frustumCulled={false}>
+        <bufferGeometry>
+          <bufferAttribute attach="attributes-position" args={[positions, 3]} />
+          <bufferAttribute attach="attributes-color" args={[colors, 3]} />
+        </bufferGeometry>
+        <pointsMaterial
+          size={0.04}
+          sizeAttenuation
+          vertexColors
+          transparent
+          opacity={0.9}
+          depthWrite={false}
+          blending={AdditiveBlending}
+        />
+      </points>
+    </group>
+  );
+}
+
+export default function MorphDemo() {
+  const t = useTranslations('Showcase.ui');
+  const [shape, setShape] = useState('sphere');
+
+  return (
+    <div className="absolute inset-0 flex flex-col">
+      <div className="relative min-h-[300px] flex-1">
+      <Canvas dpr={[1, 1.6]} camera={{ position: [0, 0, 6.2], fov: 50 }}>
+        <color attach="background" args={['#050508']} />
+        <FitScene radius={2.7} />
+        <Particles shape={shape} />
+      </Canvas>
+      </div>
+      <div className="shrink-0 p-3">
+        <Panel className="pointer-events-auto">
+          <ChipGroup
+            label={t('shape')}
+            value={shape}
+            onChange={setShape}
+            options={Object.keys(GENERATORS).map((v) => ({ value: v, label: t(`morphShapes.${v}`) }))}
+          />
+        </Panel>
+      </div>
+    </div>
+  );
+}
diff --git a/components/showcase/demos/PaletteDemo.jsx b/components/showcase/demos/PaletteDemo.jsx
